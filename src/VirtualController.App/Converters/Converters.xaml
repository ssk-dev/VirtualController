<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:VirtualController.App.Converters">

    <!-- Gemeinsame Value-Converter der Anwendung. Ausgelagert aus App.xaml in eine eigenstaendige,
         per Source= referenzierbare ResourceDictionary, damit sowohl App.xaml (fuer MainWindow.xaml)
         als auch DeviceConfigTemplates.xaml (fuer den "Gerätekonfiguration"-Tab) dieselben Converter
         nutzen koennen. Grund: StaticResource-Referenzen innerhalb von DataTemplates werden beim
         Kompilieren der jeweiligen XAML-Datei im Scope dieser Datei selbst (+ ihrer eigenen
         MergedDictionaries) aufgeloest - NICHT im Scope einer uebergeordneten Datei, die sie per
         MergedDictionaries einbindet. Waeren die Converter (wie zuvor) ausschliesslich in App.xaml
         definiert, wuerden alle {StaticResource ...}-Verweise innerhalb der in DeviceConfigTemplates.xaml
         definierten Templates zur Laufzeit beim ersten Rendern (z.B. erster Klick auf den
         "Gerätekonfiguration"-Tab) mit einer XamlParseException fehlschlagen. -->
    <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibilityConverter" />
    <conv:BoolToHighlightBrushConverter x:Key="BoolToHighlightBrushConverter" />
    <conv:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
    <conv:BoolToUnsavedForegroundConverter x:Key="BoolToUnsavedForegroundConverter" />
    <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    <conv:FractionToStarGridLengthConverter x:Key="FractionToStarGridLengthConverter" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:BoolToLogButtonTextConverter x:Key="BoolToLogButtonTextConverter" />
    <conv:BoolToBenchmarkButtonTextConverter x:Key="BoolToBenchmarkButtonTextConverter" />
    <conv:BoolToDriverSubtextConverter x:Key="BoolToDriverSubtextConverter" />

</ResourceDictionary>
