<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:VirtualController.App.Converters">

    <!-- Shared application value converters, moved from App.xaml into a standalone,
         source-referenceable ResourceDictionary so both App.xaml (for MainWindow.xaml)
         and DeviceConfigTemplates.xaml (for the "Device Configuration" tab) can use them.
         StaticResource references inside DataTemplates are resolved at compile time in the scope
         of the XAML file that defines the template, plus its own MergedDictionaries, not in the
         scope of a parent file that merges it. If the converters were defined only in App.xaml,
         as before, every {StaticResource ...} reference in templates defined in
         DeviceConfigTemplates.xaml would fail at runtime with a XamlParseException when first
         rendered (for example, when the "Device Configuration" tab is opened). -->
    <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibilityConverter" />
    <conv:BoolToHighlightBrushConverter x:Key="BoolToHighlightBrushConverter" />
    <conv:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
    <conv:BoolToUnsavedForegroundConverter x:Key="BoolToUnsavedForegroundConverter" />
    <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    <conv:FractionToStarGridLengthConverter x:Key="FractionToStarGridLengthConverter" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:TranslationKeyConverter x:Key="TranslationKeyConverter" />

</ResourceDictionary>
