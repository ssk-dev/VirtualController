<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, Platforms, PlatformTarget, LangVersion: see Directory.Build.props -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Required for the tray icon (System.Windows.Forms.NotifyIcon); WPF has no native tray icon support. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VirtualController.App</RootNamespace>
    <AssemblyName>VirtualController</AssemblyName>
    <!-- Application icon for the generated executable (File Explorer, taskbar, window title, Alt+Tab). -->
    <ApplicationIcon>..\..\assets\VirtualController.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publish settings: always produce a self-contained single-file executable with "dotnet publish",
    so the target machine does not need a separate .NET installation. This executable is then copied
    automatically to the repository root.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualController.Core\VirtualController.Core.csproj" />
  </ItemGroup>

    <!-- Also embed the icon as a WPF resource so individual windows can reference it through
      pack://application:,,,/ (see Window.Icon bindings in the XAML files). ApplicationIcon above sets
      the executable's icon for File Explorer/taskbar, but not necessarily each WPF window's title bar icon. -->
  <ItemGroup>
    <Resource Include="..\..\assets\VirtualController.ico" Link="Icons\VirtualController.ico" />
    <Resource Include="..\..\assets\logo.png" Link="Icons\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT-lizenzierte, offizielle MVVM-Bausteine (ObservableObject, RelayCommand, AsyncRelayCommand, Source-Generatoren) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="translations\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    After each "dotnet publish", copies the new self-contained executable (and PDB) to the repository root,
    replacing the older version so the root executable always matches the latest build.
  -->
  <Target Name="CopyPublishedExeToRepoRoot" AfterTargets="Publish">
    <PropertyGroup>
      <RepoRootDir>$(MSBuildThisFileDirectory)..\..\</RepoRootDir>
    </PropertyGroup>
    <ItemGroup>
      <PublishedExeFiles Include="$(PublishDir)VirtualController.exe;$(PublishDir)VirtualController.pdb;$(PublishDir)VirtualController.Core.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedExeFiles)" DestinationFolder="$(RepoRootDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="VirtualController.exe copied to '$(RepoRootDir)' (overwritten)." />
  </Target>

</Project>
