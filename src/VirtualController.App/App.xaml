<Application x:Class="VirtualController.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Converters/Converters.xaml" />
                <ResourceDictionary Source="Views/Controls/DeviceConfigTemplates.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Globaler Standard-Look fuer alle Fenster der Anwendung: dunkler App-Hintergrund und helle
             Standard-Schriftfarbe. Als impliziter Style (kein x:Key, TargetType="Window") gilt dies
             automatisch fuer jedes Window in der Anwendung, ohne dass es explizit referenziert werden
             muss. Foreground ist eine vererbte Eigenschaft (Property Value Inheritance) und wirkt dadurch
             automatisch auf alle Kind-Controls, die keine eigene, explizite Foreground setzen - Background
             dagegen wird NICHT vererbt und muss daher bei einzelnen Panels/Controls mit eigenem
             Standard-Hintergrund (z.B. TabControl) zusaetzlich explizit auf Transparent gesetzt werden
             (siehe MainWindow.xaml). -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="#F6FBFD" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
