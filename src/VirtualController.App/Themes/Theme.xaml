<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Central color palette for the dark "Virtual Controller" design, based on the original HTML/CSS
         mockup (see assets/style.css and assets/layout-mapping.html): a strong cyan accent for primary
         actions, a dark panel surface slightly lighter than the app background (#010d19) for cards/inputs,
         and a blue-toned border. Named brushes let global base styles and future UI updates share the same
         palette without duplicating color values. -->

    <SolidColorBrush x:Key="AccentBrush" Color="#02B4FE" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#11DBFE" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#02B4FE" Offset="0" />
        <GradientStop Color="#11DBFE" Offset="1" />
    </LinearGradientBrush>

    <!-- Bild-2-Palette: dunkleres Navy mit stärkerem Kontrast für Karten und Panels -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0D1B2E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#02B4FE" />
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#02B4FE" />
    <SolidColorBrush x:Key="CardSelectedBackgroundBrush" Color="#0A2A4A" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FF4C4C" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#FFA500" />

    <SolidColorBrush x:Key="IconBrush" Color="#02B4FE" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#7997CB" />

    <!-- Darkest palette tone, matching the app background previously defined as a literal hex value in
         App.xaml's Window style. Named so individual regions (e.g. the root DockPanel in MainWindow.xaml)
         can set it explicitly rather than relying on a transparent background and the parent Window's
         background showing through. That approach caused some areas, such as the Available devices list,
         to render white instead of dark. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#010D19" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0B1626" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A517D" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7997CB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CE8A4" />

     <SolidColorBrush x:Key="PanelVirtualControllersBorderBrush" Color="#061a2b" />
     <LinearGradientBrush x:Key="PanelVirtualControllersBackgroundBrush"
                     StartPoint="0,0"
                     EndPoint="1,0">
          <GradientStop Color="#33004459" Offset="0"/>
          <GradientStop Color="#660f495b" Offset="1"/>
     </LinearGradientBrush>
     <SolidColorBrush x:Key="PanelVirtualControllersBorderBrushActive" Color="#043960" />
     <LinearGradientBrush x:Key="PanelVirtualControllersBackgroundBrushActive"
                     StartPoint="0,0"
                     EndPoint="1,0">
          <GradientStop Color="#33008cff" Offset="0"/>
          <GradientStop Color="#660f495b" Offset="1"/>
     </LinearGradientBrush>



    <!-- Warning colors (background/border/text) for non-critical notices, such as the HID diagnostics in
         BenchmarkWindow.xaml. Similar to SuccessBrush but in amber tones. Kept dark and desaturated instead
         of using the original bright #FFF3CD/#FFECB5/#856404 combination so the notice stands out without
         appearing harsh against the dark app background. -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3D2E00" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#C9962C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD666" />

    <!-- Matches the global Window foreground (#F6FBFD; see App.xaml). Also needs to exist as a named brush
         because standard WPF controls such as Button/CheckBox/ComboBox have system-theme foreground defaults
         that override inheritance from Window. The implicit styles in Styles.xaml therefore set Foreground
         explicitly instead of relying on property value inheritance. -->
    <SolidColorBrush x:Key="TextBrush" Color="#F6FBFD" />

    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#14385C" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1D5A8F" />

</ResourceDictionary>
