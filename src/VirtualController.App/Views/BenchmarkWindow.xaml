<Window x:Class="VirtualController.App.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
        xmlns:loc="clr-namespace:VirtualController.App.Localization"
        xmlns:metrics="clr-namespace:VirtualController.Core.Benchmark.Metrics;assembly=VirtualController.Core"
        xmlns:benchmark="clr-namespace:VirtualController.Core.Benchmark;assembly=VirtualController.Core"
        Title="{loc:LocFormat Key=benchmark.title_format, Value={Binding Device.DisplayName}}"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner">

        <!-- Intentionally non-modal (see MainWindow.xaml.cs; no ShowDialog()) and shown in the taskbar so the
            user can continue interacting with the main window, such as viewing other device tabs, while this
            window displays live values. See BenchmarkWindow.xaml.cs for per-device singleton behavior. -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Padding="8,3"
                    Content="{loc:LocBool Value={Binding Device.IsBenchmarking}, WhenTrue=benchmark.stop, WhenFalse=benchmark.start}"
                    Command="{Binding Device.ToggleBenchmarkCommand}" />
            <TextBlock Text="{loc:LocFormat Key=benchmark.duration_format, Value={Binding DurationSeconds}}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                   Text="{loc:Loc benchmark.no_measurements}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>

                 <!-- Timing: measured polling rate (see PollingRateMetrics), shown in Hz rather than ms.
                     Includes the current value (last interval), minimum/maximum (derived from the longest
                     and shortest observed intervals; note the inverse relationship), mean, and median. -->
                <TextBlock Text="{loc:Loc benchmark.timing}" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.current_format, Value={Binding CurrentPollingRateHz}}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:LocFormat Key=benchmark.samples_format, Value={Binding PollingSampleCount}}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.min_format, Value={Binding MinPollingRateHz}}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:LocFormat Key=benchmark.max_format, Value={Binding MaxPollingRateHz}}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.mean_format, Value={Binding ActualPollingRateHz}}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:LocFormat Key=benchmark.median_format, Value={Binding MedianPollingRateHz}}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.interval_stddev_format, Value={Binding IntervalStdDevMs}}" Margin="0,2" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                 <!-- Latency jitter (deviation from the nominal USB polling interval); see LatencyMetrics
                     documentation for the limitation that this is not a true end-to-end measurement. -->
                 <TextBlock Text="{loc:Loc benchmark.latency_title}" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Margin="0,0,0,12"
                           Visibility="{Binding LatencySupported, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                           Text="{loc:Loc benchmark.latency_unavailable}" Foreground="{StaticResource MutedTextBrush}" />
                <Grid Margin="0,0,0,12"
                      Visibility="{Binding LatencySupported, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:LocFormat Key=benchmark.jitter_mean_format, Value={Binding LatencyJitterMeanMs}}" Margin="0,2" />
                    <TextBlock Grid.Column="1" Text="{loc:LocFormat Key=benchmark.jitter_max_format, Value={Binding LatencyJitterMaxMs}}" Margin="0,2" />
                </Grid>

                 <!-- Reliability: see ReliabilityMetrics documentation. Duplicate reports are normal for most
                     gamepads and are not an error indicator. -->
                 <TextBlock Text="{loc:Loc benchmark.reliability}" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.total_reports_format, Value={Binding TotalReportCount}}" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:LocFormat Key=benchmark.dropped_format, Value={Binding EstimatedDroppedReports}}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:LocFormat Key=benchmark.duplicates_format, Value={Binding ConsecutiveDuplicateReportCount}}" Margin="0,2" />
                </Grid>

                <!-- Signal: one entry per axis; see SignalMetrics documentation. -->
                <TextBlock Text="{loc:Loc benchmark.signal_per_axis}" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding SignalAxes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type metrics:SignalAxisResult}">
                            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Axis}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:LocFormat Key=benchmark.effective_resolution_format, Value={Binding EffectiveBits}}" />
                                    <TextBlock Text="{loc:LocFormat Key=benchmark.declared_resolution_format, Value={Binding DeclaredElementBits}}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{loc:LocFormat Key=benchmark.noise_format, Value={Binding NoiseStdDevRaw}}"
                                               Visibility="{Binding NoiseSupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{loc:Loc benchmark.noise_unavailable}" Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding NoiseSupported, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{loc:LocFormat Key=benchmark.deadzone_format, Value={Binding DeadzonePercentOfRange}}"
                                               Visibility="{Binding DeadzoneSupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                 <!-- HID diagnostics: all HID interfaces with the matching vendor/product ID found when the
                     session was created (see BenchmarkDiagnosticsInfo). Multiple entries may explain a
                     session that reports zero samples despite opening a report source (composite device with
                     the wrong interface selected); see BenchmarkWindowViewModel.HasMultipleHidCandidates. -->
                 <TextBlock Text="{loc:Loc benchmark.hid_diagnostics}" FontWeight="Bold" Margin="0,0,0,4" />
                <Border Margin="0,0,0,6" Padding="6" Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasMultipleHidCandidates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
                               Text="{loc:Loc benchmark.hid_multiple_warning}" />
                </Border>
                <ItemsControl ItemsSource="{Binding HidCandidates}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type benchmark:BenchmarkHidCandidateInfo}">
                            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding DevicePath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Text="{loc:LocFormat Key=benchmark.report_length_format, Value={Binding MaxInputReportLength}}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{loc:Loc benchmark.hid_used}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
