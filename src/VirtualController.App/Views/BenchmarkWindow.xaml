<Window x:Class="VirtualController.App.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
        xmlns:metrics="clr-namespace:VirtualController.Core.Benchmark.Metrics;assembly=VirtualController.Core"
        xmlns:benchmark="clr-namespace:VirtualController.Core.Benchmark;assembly=VirtualController.Core"
        Title="{Binding Device.DisplayName, StringFormat='Benchmark - {0}'}"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner">

    <!-- Bewusst NICHT modal (siehe MainWindow.xaml.cs, kein ShowDialog()) und ohne ShowInTaskbar="False":
         der Nutzer soll waehrend eine Sitzung laeuft weiterhin mit dem Hauptfenster interagieren koennen
         (z.B. andere Geraete-Tabs ansehen), waehrend dieses Fenster die Live-Werte anzeigt - siehe
         BenchmarkWindow.xaml.cs fuer das Singleton-Verhalten pro Geraet. -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Padding="8,3"
                    Content="{Binding Device.IsBenchmarking, Converter={StaticResource BoolToBenchmarkButtonTextConverter}}"
                    Command="{Binding Device.ToggleBenchmarkCommand}" />
            <TextBlock Text="{Binding DurationSeconds, StringFormat='Laufzeit: {0:0.0} s'}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                   Text="Noch keine Messwerte - starte den Benchmark ueber den Button oben, um hier fortlaufend aktualisierte Kennzahlen zu sehen." />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>

                <!-- Timing: tatsaechlich gemessene Polling-Rate, siehe PollingRateMetrics. Bewusst in Hz
                     (nicht ms) dargestellt, mit Momentanwert (letztes Intervall), Minimum/Maximum (aus dem
                     laengsten/kuerzesten beobachteten Intervall - Inversionsrichtung beachten) sowie
                     Mittelwert und Median ueber die gesamte Sitzung. -->
                <TextBlock Text="Timing" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CurrentPollingRateHz, StringFormat='Aktuell: {0:0.0} Hz'}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PollingSampleCount, StringFormat='Messwerte: {0}'}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MinPollingRateHz, StringFormat='Min: {0:0.0} Hz'}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaxPollingRateHz, StringFormat='Max: {0:0.0} Hz'}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ActualPollingRateHz, StringFormat='Mittel: {0:0.0} Hz'}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MedianPollingRateHz, StringFormat='Median: {0:0.0} Hz'}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding IntervalStdDevMs, StringFormat='Intervall (StdAbw.): {0:0.00} ms'}" Margin="0,2" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                <!-- Latenz-Jitter (Abweichung vom nominalen USB-Polling-Intervall) - siehe
                     LatencyMetrics-Klassendokumentation fuer die Einschraenkung "kein echtes End-zu-Ende". -->
                <TextBlock Text="Latenz-Jitter (Naeherung relativ zum nominalen USB-Intervall)" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Margin="0,0,0,12"
                           Visibility="{Binding LatencySupported, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                           Text="Nicht ermittelbar (kein nominales USB-Polling-Intervall bekannt)." Foreground="{StaticResource MutedTextBrush}" />
                <Grid Margin="0,0,0,12"
                      Visibility="{Binding LatencySupported, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LatencyJitterMeanMs, StringFormat='Jitter (Mittel): {0:0.00} ms'}" Margin="0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding LatencyJitterMaxMs, StringFormat='Jitter (Max): {0:0.00} ms'}" Margin="0,2" />
                </Grid>

                <!-- Reliability: siehe ReliabilityMetrics-Klassendokumentation - Duplicate Reports sind bei
                     den meisten Gamepads NORMAL, kein Fehlerindikator. -->
                <TextBlock Text="Zuverlaessigkeit" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TotalReportCount, StringFormat='Reports gesamt: {0}'}" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EstimatedDroppedReports, StringFormat='Geschaetzt verpasst: {0}'}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ConsecutiveDuplicateReportCount, StringFormat='Duplikate (informativ): {0}'}" Margin="0,2" />
                </Grid>

                <!-- Signal: je Achse ein Eintrag, siehe SignalMetrics-Klassendokumentation. -->
                <TextBlock Text="Signal je Achse" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding SignalAxes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type metrics:SignalAxisResult}">
                            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Axis}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EffectiveBits, StringFormat='Effektive Aufloesung: {0:0.0} Bit'}" />
                                    <TextBlock Text="{Binding DeclaredElementBits, StringFormat='Deklarierte Aufloesung: {0} Bit'}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding NoiseStdDevRaw, StringFormat='Rauschen (Ruhephasen): {0:0.00} (Rohwert)'}"
                                               Visibility="{Binding NoiseSupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="Rauschen: nicht ermittelbar (keine Ruhephase beobachtet)" Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding NoiseSupported, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{Binding DeadzonePercentOfRange, StringFormat='Geschaetzte Totzone: {0:P1} des Wertebereichs'}"
                                               Visibility="{Binding DeadzoneSupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- HID-Diagnose: alle bei der Sitzungserstellung gefundenen HID-Interfaces mit passender
                     Vendor-/Product-ID (siehe BenchmarkDiagnosticsInfo). Mehr als ein Eintrag ist der
                     wahrscheinlichste Grund dafuer, dass eine Sitzung trotz erfolgreich geoeffneter
                     Report-Quelle durchgehend 0 Messwerte liefert (Composite-Geraet, falsches Interface
                     geoeffnet) - siehe BenchmarkWindowViewModel.HasMultipleHidCandidates. -->
                <TextBlock Text="HID-Diagnose" FontWeight="Bold" Margin="0,0,0,4" />
                <Border Margin="0,0,0,6" Padding="6" Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasMultipleHidCandidates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
                               Text="Mehrere HID-Interfaces mit derselben Vendor-/Product-ID gefunden. Falls trotz Aktivitaet am Geraet keine Messwerte eintreffen, wurde vermutlich das falsche Interface geoeffnet (siehe markierten Eintrag unten)." />
                </Border>
                <ItemsControl ItemsSource="{Binding HidCandidates}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type benchmark:BenchmarkHidCandidateInfo}">
                            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding DevicePath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Text="{Binding MaxInputReportLength, StringFormat='Max. Input-Report-Laenge: {0} Byte'}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Verwendet fuer diese Sitzung" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
