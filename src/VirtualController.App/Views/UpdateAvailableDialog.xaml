<Window x:Class="VirtualController.App.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VirtualController.App.Localization"
        Title="{loc:Loc update_dialog.title}" Width="420" SizeToContent="Height"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

        <!-- Modal update dialog (see UpdateAvailableDialog.xaml.cs) that announces a new version and offers
            "Install update" and "Skip update". During installation (IsInstalling), both buttons are disabled
            and a progress bar with the current step (e.g. "Step 1 of 4: Downloading files") is shown. The
            dialog also contains an expandable changelog/release notes section (see ReleaseNotesText and
            HasReleaseNotes), collapsed by default to keep it compact. SizeToContent="Height" lets the window
            grow or shrink automatically when the section is expanded or collapsed. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc update_dialog.skip}" Command="{Binding SkipUpdateCommand}" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="{loc:Loc update_dialog.install}" Command="{Binding InstallCommand}" Padding="8,4" IsDefault="True"
                    FontWeight="Bold" />
        </StackPanel>

        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="{loc:Loc update_dialog.message}" />
            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}">
                <Run Text="{loc:Loc update_dialog.installed}" /><Run Text="{Binding InstalledVersionText, Mode=OneWay}" />
                <Run Text="{loc:Loc update_dialog.available}" /><Run Text="{Binding AvailableVersionText, Mode=OneWay}" />
            </TextBlock>

            <Expander Margin="0,10,0,0" Header="{loc:Loc update_dialog.changes}" IsExpanded="False"
                      Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ReleaseNotesText, Mode=OneWay}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Expander>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Minimum="0" Maximum="100" Height="16" Value="{Binding InstallProgressPercent, Mode=OneWay}" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap"
                           Text="{Binding InstallStepText}" />
                <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" TextWrapping="Wrap"
                           Text="{loc:Loc update_dialog.restarting}"
                           Visibility="{Binding IsRestarting, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
