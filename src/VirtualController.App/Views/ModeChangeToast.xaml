<Window x:Class="VirtualController.App.Views.ModeChangeToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="70" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Focusable="False">

        <!-- Display-only popup with no user interaction (see ModeChangeToast.xaml.cs). Appears briefly in the
            bottom-left corner, stays on top, and closes automatically when its display duration expires. -->
    <Border Background="#E6222222" CornerRadius="6" Padding="14,10">
        <StackPanel>
            <TextBlock x:Name="ControllerNameText" Foreground="#CCCCCC" FontSize="11" />
            <TextBlock x:Name="ModeNameText" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
