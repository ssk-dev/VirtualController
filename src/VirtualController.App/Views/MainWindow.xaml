<Window x:Class="VirtualController.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
        xmlns:loc="clr-namespace:VirtualController.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:diag="clr-namespace:VirtualController.App.Diagnostics"
        Title="{Binding WindowTitle}" Height="900" Width="1440"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Topmost="{Binding AlwaysOnTop}"
        Closing="MainWindow_OnClosing"
        PreviewMouseMove="OnInspectorPreviewMouseMove"
        PreviewMouseLeftButtonDown="OnInspectorPreviewMouseLeftButtonDown"
        PreviewKeyDown="OnInspectorPreviewKeyDown">

        <!-- Replaces the bright, unthemed native Windows title bar with a custom dark title bar (see the
            TitleBar border with DockPanel.Dock="Top" below). WindowChrome is a built-in WPF feature and
            adds no NuGet dependency; it preserves native resizing at the window edges. CaptionHeight="32"
            marks the top 32-pixel strip (matching the custom TitleBar border below) as the drag and
            double-click-to-maximize area, just like the native title bar. Interactive elements inside it
            (the three window controls) must explicitly set WindowChrome.IsHitTestVisibleInChrome="True"
            so their clicks are not consumed by the drag behavior. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Root Grid wraps the window's real content (the DockPanel below) together with the layout inspector
        overlay (see Diagnostics/LayoutInspectorOverlay.cs and OnInspectorPreviewMouseMove/
        OnInspectorPreviewKeyDown in MainWindow.xaml.cs), toggled with Ctrl+Shift+I like a browser's "Inspect
        element" tool. The overlay is the last/topmost Grid child so its highlight box and info panel are
        always drawn above every other visual, but it sets IsHitTestVisible="False" on itself and all its
        children so it never blocks clicks on the real UI underneath. -->
    <Grid>
    <DockPanel Background="{StaticResource AppBackgroundBrush}">
           <!-- Custom dark replacement for the native Windows title bar (see WindowStyle="None" above):
               the app icon and title are on the left, and window controls (minimize/maximize-restore/close)
               are on the right. WindowChrome (CaptionHeight="32") makes the whole area a drag and
               double-click-to-maximize zone. The three buttons explicitly set
               WindowChrome.IsHitTestVisibleInChrome="True" so their clicks are not consumed by dragging.
               MainWindow.xaml.cs updates the maximize/restore glyph (MaximizeRestoreGlyph) for the current
               WindowState because a plain XAML trigger cannot bind directly to Window.WindowState here. -->
        
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="24" Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              <!--
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/Icons/VirtualController.ico" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding WindowTitle}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
               -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeButtonClicked" ToolTip="{loc:Loc window.minimize}">
                        <TextBlock Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMaximizeRestoreButtonClicked" ToolTip="{loc:Loc window.maximize_restore}">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseButtonClicked" ToolTip="{loc:Loc window.close}">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header: driver status and global actions -->
        <Border DockPanel.Dock="Top" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" Padding="20,10,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Icons/logo.png" Height="60" Margin="0,0,0,0"
                           VerticalAlignment="Center" />

                    <!-- Vertical divider between the logo and ViGEmBus status pill. Its height matches the
                        shared HeaderActionButtonHeight for header actions (see Themes/Styles.xaml), with
                        20 pixels of spacing on either side. -->
                    <Border Width="1" Margin="20,0" VerticalAlignment="Center"
                            Background="{StaticResource PanelBorderBrush}"
                            Height="{StaticResource HeaderActionButtonHeight}" />

                    <!-- ViGEmBus status pill with a dot indicator and two lines of text (main label and
                        subtitle), based on the original design in assets/layout-mapping.html
                        (".header-vigembus-box"). It has no separate border and shares the header's
                        AppBackgroundBrush so it blends into the header. -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                
                        <Border BorderThickness="0" Padding="10,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Fill="{Binding DriverReady, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DriverStatusText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{loc:LocBool Value={Binding DriverReady}, WhenTrue=driver.subtext_active, WhenFalse=driver.subtext_unavailable}"
                                            FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastErrorMessage}" Foreground="Red" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Height="{StaticResource HeaderActionButtonHeight}">
                            <!-- Placeholder icons (Segoe MDL2 Assets) before each button label, based on the
                                icon design in assets/layout-mapping.html; replace these with custom assets later. -->
                        <Button Command="{Binding RefreshDevicesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc header.refresh_devices}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadProfilesCommand}" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc header.load_profiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="12,0,4,0" 
                                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc header.unsaved_changes}" Foreground="{StaticResource WarningBadgeBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding SaveProfilesCommand}" Margin="4,0"
                                Foreground="{Binding HasUnsavedChanges, Converter={StaticResource BoolToUnsavedForegroundConverter}}"
                                FontWeight="{Binding HasUnsavedChanges, Converter={StaticResource BoolToFontWeightConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc header.save_profiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenWindowsGameControllersCommand}" Margin="4,0"
                                ToolTip="{loc:Loc header.gamecontrollers_tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE975;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc header.gamecontrollers}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,12,0">
                                <TextBlock Text="{loc:LocFormat Key=header.version_format, Value={Binding Update.CurrentVersionText}}" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

           <!-- Main tab bar: divides the window into "Mapping" (existing controller, mode, and mapping
               management), "Device Configuration" (the former separate device configuration dialog,
               now a tab with an inner tab for each device), and "Settings" (for global app settings). -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
            <TabItem Header="{loc:Loc tabs.mapping}">
                <DockPanel>
                    <!-- Left column: virtual controller list. Uses the shared sidebar styles (see Styles.xaml)
                        so this list, the Device Configuration tab's device list, and any future sidebar all
                        share the exact same Border/ListBox/ListBoxItem appearance and behavior. -->
                    <Border Style="{StaticResource SidebarBorderStyle}">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Margin="8" Padding="6" Command="{Binding AddControllerCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc mapping.new_controller}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ListBox ItemsSource="{Binding Controllers}"
                                     x:Name="ControllerListBox"
                                     SelectedItem="{Binding SelectedController}"
                                     Style="{StaticResource SidebarListBoxStyle}"
                                     ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VirtualControllerViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Layout}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right side: details and mapping table for the selected controller -->
                    <Grid x:Name="ControllerDetailGrid" DataContext="{Binding SelectedController}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc mapping.name}" VerticalAlignment="Center" Width="90" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="220" />

                                    <TextBlock Text="{loc:Loc mapping.layout}" VerticalAlignment="Center" Width="60" Margin="16,0,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:VirtualControllerViewModel.LayoutOptions}"
                                              SelectedItem="{Binding Layout}" Width="120"
                                              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                              ToolTip="{loc:Loc mapping.layout_locked_tooltip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TranslationKeyConverter}, ConverterParameter='mapping.layout'}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="{loc:Loc mapping.backend}" VerticalAlignment="Center" Width="70" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding ResolvedBackend}" VerticalAlignment="Center" FontStyle="Italic" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc mapping.polling}" VerticalAlignment="Center" Width="90" />
                                    <TextBox Text="{Binding PollingRateHz, UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                    <TextBlock Text="{Binding StatusText}" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />

                                    <Button Command="{Binding StartCommand}" Margin="16,0,4,0" Style="{StaticResource SuccessButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.start}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding StopCommand}" Margin="12,0" Style="{StaticResource DangerButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.stop}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                     <!-- Uses HidHide to block this controller's assigned physical devices from other
                                         applications while the virtual controller is running (see
                                         ControllerManager/HidHideController). Disabled when the HidHide driver is
                                         unavailable (see MainViewModel.IsHidHideAvailable). This area already uses
                                         SelectedController as its DataContext, so the window-level MainViewModel is
                                         accessed through the Window DataContext. -->
                                    <CheckBox Content="HidHide" VerticalAlignment="Center" Margin="16,0,0,0"
                                              IsChecked="{Binding HidHideEnabled}"
                                              IsEnabled="{Binding DataContext.IsHidHideAvailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="{loc:Loc mapping.hidhide_tooltip}" />

                                    <Button Command="{Binding RemoveCommand}" Margin="16,0,0,0" Style="{StaticResource DangerButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.remove}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                  <!-- Automatically starts or stops this controller based on whether the selected
                                      program is running. The process path is checked through background polling
                                      (see MainViewModel.OnAutoStartTimerTick). -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox Content="{loc:Loc mapping.auto_start}" VerticalAlignment="Center"
                                              IsChecked="{Binding AutoStartEnabled}"
                                              ToolTip="{loc:Loc mapping.auto_start_tooltip}" />
                                    <Button Command="{Binding ChooseAutoStartExecutableCommand}" Margin="16,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.choose_program}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding AutoStartExecutableDisplayName}" VerticalAlignment="Center" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            <!-- Mode switching uses either one controller-wide toggle trigger that advances to the next
                                enabled mode on each rising edge, or a separate switch trigger for each mode that
                                activates that mode directly (see the tab bar below). Both mechanisms are always fully
                                configured; this selector determines which one ControllerSession evaluates at runtime. -->
                        <Border Grid.Row="1" Padding="12,8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc mapping.mode_switch}" VerticalAlignment="Center" FontWeight="Bold" Width="130" />
                                <ComboBox ItemsSource="{x:Static vm:VirtualControllerViewModel.ModeSwitchMechanismOptions}"
                                          SelectedItem="{Binding ModeSwitchMechanism}" Width="110">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslationKeyConverter}, ConverterParameter='mapping.mode'}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                  <!-- The toggle trigger is defined beside the selector, rather than in the tab bar,
                                      because it applies to the whole controller, not to an individual mode. -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                            Visibility="{Binding ModeSwitchMechanism, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Toggle}">
                                    <Button Command="{Binding CaptureToggleTriggerCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.capture}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnAssignToggleTriggerClicked" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
                                            ToolTip="{loc:Loc mapping.assign_tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc mapping.assign}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ToggleTriggerDisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:LocFormat Key=mapping.capture_countdown, Value={Binding CaptureCountdownSeconds}}" Foreground="OrangeRed" VerticalAlignment="Center"
                                               Visibility="{Binding IsCapturingToggleTrigger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                  <!-- Optional on-screen notification: briefly shows the controller and mode names in
                                      the bottom-left corner for every mode change, whether triggered by a tab click
                                      or an input trigger (see ModeChangeToast). -->
                                  <CheckBox Content="{loc:Loc mapping.notify_mode_change}" IsChecked="{Binding NotifyOnModeChange}"
                                          VerticalAlignment="Center" Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>

                            <!-- Mode tab bar: each tab shows its name, a green active indicator (only when
                                IsActive == true; see ModeViewModel), an enabled checkbox, and a remove button.
                                Clicking a tab outside the checkbox or remove button selects and immediately
                                activates that controller mode (see VirtualControllerViewModel.SelectedMode). -->
                        <Border Grid.Row="2" Padding="8,6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModeViewModel}">
                                            <Border BorderThickness="1" Padding="24,12"
                                                    PreviewMouseLeftButtonDown="OnModeTabBorderPreviewMouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding IsActive, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                             ToolTip="{loc:Loc mapping.active_mode_tooltip}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                             VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="2,0" />
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                              ToolTip="{loc:Loc mapping.disabled_mode_tooltip}" />

                                                    <!-- Only used with the switch mechanism: this mode's individual trigger. -->
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                Visibility="{Binding DataContext.ModeSwitchMechanism, ElementName=ControllerDetailGrid, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Switch}">
                                                        <Button Command="{Binding CaptureSwitchTriggerCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{loc:Loc mapping.capture}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="OnAssignSwitchTriggerClicked" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
                                                                ToolTip="{loc:Loc mapping.assign_tooltip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{loc:Loc mapping.assign}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="{Binding SwitchTriggerDisplayName}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:LocFormat Key=mapping.capture_countdown, Value={Binding CaptureCountdownSeconds}}" Foreground="OrangeRed" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCapturingSwitchTrigger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding SwitchTriggerValidationError}" Foreground="Red" FontWeight="Bold"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="220"
                                                                   Visibility="{Binding SwitchTriggerValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <Button Command="{Binding RemoveCommand}" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                                                            ToolTip="{loc:Loc mapping.remove_mode_tooltip}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Command="{Binding AddModeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc mapping.new_mode}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Left column: mapping table for the selected virtual controller -->
                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                                        Margin="0,0,0,8" Command="{Binding AddMappingCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc mapping.add_row}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                  <!-- The mapping table is grouped by target type (button/axis/trigger/D-pad). Instead of
                                      one flat DataGrid (formerly named "MappingsDataGrid"), each target type gets its
                                      own heading and DataGrid (see ModeViewModel.MappingGroups/RebuildMappingGroups).
                                      A group is shown only while it contains at least one mapping row, and group order
                                      follows the "Target type" ComboBox options (MappingRowViewModel.TargetKindOptions).
                                      Groups are intentionally not expandable. The outer ScrollViewer keeps the name
                                      "MappingsScrollViewer" so the existing ComboBox SelectionChanged workaround
                                      (see MainWindow.xaml.cs) can remain registered on an ancestor of all DataGrids.
                                      Selector.SelectionChangedEvent bubbles regardless of the number or nesting of
                                      intervening ItemsControls. -->
                                <ScrollViewer x:Name="MappingsScrollViewer" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnMappingsScrollViewerPreviewMouseWheel">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Unassigned mapping rows (ModeViewModel.UnassignedMappings) are newly added rows that
                                            do not yet have a physical source assigned through Capture or Assign. Show them at the
                                            top without a heading and outside all target-type groups because they cannot yet be
                                            meaningfully classified by target type. Previously, a useless placeholder such as
                                            "- Button 0 (disconnected)" appeared in the Button group. Hide this entire section
                                            when there are no unassigned rows. -->
                                        <DataGrid ItemsSource="{Binding SelectedMode.UnassignedMappings, NotifyOnTargetUpdated=True}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  EnableRowVirtualization="False" Margin="0,0,0,16"
                                                  HorizontalAlignment="Left"
                                                  Binding.TargetUpdated="OnMappingsDataGridTargetUpdated"
                                                  Visibility="{Binding SelectedMode.UnassignedMappings.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="{Binding IsSourceActive, Converter={StaticResource BoolToHighlightBrushConverter}}" />
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="{loc:Loc mapping.col_physical_source}" Width="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Command="{Binding CaptureCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{loc:Loc mapping.capture}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Click="OnAssignInputClicked" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
                                                                        ToolTip="{loc:Loc mapping.assign_tooltip}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{loc:Loc mapping.assign}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock Text="{Binding SourceDisplayName}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{loc:Loc mapping.disconnected}" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                <TextBlock Text="{loc:LocFormat Key=mapping.capture_countdown, Value={Binding CaptureCountdownSeconds}}" Foreground="OrangeRed"
                                                                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="{loc:Loc mapping.col_target_type}" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <ComboBox ItemsSource="{x:Static vm:MappingRowViewModel.TargetKindOptions}"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      SelectedItem="{Binding SelectedTargetKind}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource TranslationKeyConverter}, ConverterParameter='mapping.target_kind'}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="{loc:Loc mapping.col_target_value}" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <ComboBox ItemsSource="{Binding CurrentTargetOptions}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      SelectedValue="{Binding SelectedTargetValue}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Label, Converter={StaticResource TranslationKeyConverter}}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="{loc:Loc mapping.col_invert}" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <CheckBox IsChecked="{Binding Invert}" HorizontalAlignment="Center"
                                                                      Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="{loc:Loc mapping.col_directional}" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <CheckBox IsChecked="{Binding DirectionalOnly}" HorizontalAlignment="Center"
                                                                      ToolTip="{loc:Loc mapping.directional_tooltip}"
                                                                      Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="" Width="90">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <Button Command="{Binding RemoveCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{loc:Loc mapping.remove}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <ItemsControl ItemsSource="{Binding SelectedMode.MappingGroups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MappingGroupViewModel}">
                                                    <StackPanel Margin="0,0,0,16">
                                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />

                                                        <DataGrid ItemsSource="{Binding Rows, NotifyOnTargetUpdated=True}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  EnableRowVirtualization="False"
                                                                  HorizontalAlignment="Left"
                                                                  Binding.TargetUpdated="OnMappingsDataGridTargetUpdated">
                                                            <DataGrid.RowStyle>
                                                                 <!-- Highlight the mapping row while its assigned physical source is active
                                                                     (button pressed, axis moved, or D-pad held). This matches the behavior in
                                                                     the "Available devices" list (see PhysicalInputRowViewModel.IsActive), but
                                                                     highlights the entire mapping row instead of an individual input row. -->
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="Background" Value="{Binding IsSourceActive, Converter={StaticResource BoolToHighlightBrushConverter}}" />
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Header="{loc:Loc mapping.col_physical_source}" Width="220">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Button Command="{Binding CaptureCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{loc:Loc mapping.capture}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Click="OnAssignInputClicked" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
                                                                                    ToolTip="{loc:Loc mapping.assign_tooltip}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{loc:Loc mapping.assign}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <TextBlock Text="{Binding SourceDisplayName}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{loc:Loc mapping.disconnected}" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"
                                                                                       Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                            <TextBlock Text="{loc:LocFormat Key=mapping.capture_countdown, Value={Binding CaptureCountdownSeconds}}" Foreground="OrangeRed"
                                                                                       Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="{loc:Loc mapping.col_target_type}" Width="110">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <ComboBox ItemsSource="{x:Static vm:MappingRowViewModel.TargetKindOptions}"
                                                                                  IsSynchronizedWithCurrentItem="False"
                                                                                  SelectedItem="{Binding SelectedTargetKind}">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource TranslationKeyConverter}, ConverterParameter='mapping.target_kind'}" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="{loc:Loc mapping.col_target_value}" Width="150">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <ComboBox ItemsSource="{Binding CurrentTargetOptions}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  IsSynchronizedWithCurrentItem="False"
                                                                                  SelectedValue="{Binding SelectedTargetValue}">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Label, Converter={StaticResource TranslationKeyConverter}}" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="{loc:Loc mapping.col_invert}" Width="80">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <CheckBox IsChecked="{Binding Invert}" HorizontalAlignment="Center"
                                                                                  Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="{loc:Loc mapping.col_directional}" Width="110">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <CheckBox IsChecked="{Binding DirectionalOnly}" HorizontalAlignment="Center"
                                                                                  ToolTip="{loc:Loc mapping.directional_tooltip}"
                                                                                  Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="" Width="90">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <Button Command="{Binding RemoveCommand}" Style="{StaticResource DangerButtonStyle}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{loc:Loc mapping.remove}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            </DockPanel>

                            <!-- Right column: vertical panel listing all physical devices available to this controller -->
                            <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc mapping.available_devices}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                        <ItemsControl ItemsSource="{Binding AvailableDeviceSelections}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DeviceSelectionViewModel}">
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4"
                                                              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                                                        <Expander.Header>
                                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                                                      VerticalContentAlignment="Center" />
                                                        </Expander.Header>

                                                        <ItemsControl ItemsSource="{Binding Inputs}" Margin="24,4,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:PhysicalInputRowViewModel}">
                                                                    <Border Background="{Binding IsActive, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                                                            Padding="4,2" Margin="0,0,0,1"
                                                                            Opacity="{Binding IsEnabled, Converter={StaticResource BoolToDimOpacityConverter}}">
                                                                        <StackPanel>
                                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                     VerticalAlignment="Center" />
                                                                            <Button Command="{Binding AssignCommand}"
                                                                                    HorizontalAlignment="Left" Padding="6,1" Margin="0,4,0,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{loc:Loc mapping.assign}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Assigned devices that are currently disconnected are shown dimmed for
                                            information (the inverse of the live highlight in "Available devices"). This
                                            keeps existing assignments visible without confusing them with connected
                                            devices. Show this section only while at least one assigned device is disconnected. -->
                                        <TextBlock Text="{loc:Loc mapping.assigned_devices}" FontWeight="Bold" Margin="0,12,0,4"
                                                   Visibility="{Binding AssignedDisconnectedDeviceSelections.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                                        <ItemsControl ItemsSource="{Binding AssignedDisconnectedDeviceSelections}"
                                                      Visibility="{Binding AssignedDisconnectedDeviceSelections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AssignedDisconnectedDeviceViewModel}">
                                                    <TextBlock Text="{Binding DisplayName}" Margin="0,0,0,4" Opacity="0.4"
                                                               ToolTip="{loc:Loc mapping.assigned_disconnected_tooltip}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{loc:Loc tabs.device_config}">
                <!-- This tab explicitly switches its DataContext to DeviceConfig instead of inheriting
                     MainViewModel from the tab bar. This lets its Devices and SelectedDevice bindings
                     resolve directly against DeviceConfigViewModel, as they did when DeviceConfigWindow.xaml
                     was bound to that view model independently. -->
                <DockPanel DataContext="{Binding DeviceConfig}">
                    <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8" TextWrapping="Wrap"
                               Text="{loc:Loc devices.description}" />

                    <!-- Left column: all known physical devices, both connected and previously seen but now
                        disconnected (see MainViewModel.GetAllKnownDevices). This replaces the former inner
                        left-side tab strip with the same list-and-detail layout used in the Mapping tab.
                        The green/gray status dot indicates enabled and connected vs. disabled or disconnected;
                        the device name is also dimmed when disconnected. These states are independent and can
                        overlap. The collapsible section below the main list restores manually hidden devices
                        (see DeviceSettings.Hidden). This is needed because XInput/DirectInput cannot
                        automatically distinguish this app's ViGEmBus-emulated virtual controllers from hardware. -->
                    <Border Style="{StaticResource SidebarBorderStyle}">
                        <DockPanel>
                            <Expander DockPanel.Dock="Bottom" Header="{loc:Loc devices.hidden}" Margin="4"
                                      Visibility="{Binding HiddenDevices.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ListBox ItemsSource="{Binding HiddenDevices}" MaxHeight="200"
                                         Style="{StaticResource SidebarListBoxStyle}"
                                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
                                            <Grid Opacity="{Binding IsConnected, Converter={StaticResource BoolToDimOpacityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ManufacturerName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DeviceModelName}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                                        Command="{Binding ToggleHiddenCommand}"
                                                        ToolTip="{loc:Loc devices.show}">
                                                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>

                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                     Style="{StaticResource SidebarListBoxStyle}"
                                     ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
                                        <Grid Opacity="{Binding IsConnected, Converter={StaticResource BoolToDimOpacityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsActiveIndicator, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                     ToolTip="{loc:Loc devices.status_tooltip}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManufacturerName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DeviceModelName}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                                    Command="{Binding ToggleHiddenCommand}"
                                                    ToolTip="{loc:Loc devices.hide_tooltip}">
                                                <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right side: details for the selected device, rendered through the implicit
                        DeviceConfigDeviceViewModel template (see DeviceConfigTemplates.xaml). -->
                    <ContentPresenter Content="{Binding SelectedDevice}" Margin="8,0,8,8" />
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding SettingsTabHeaderText}">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding SettingsLanguageLabelText}" FontWeight="Bold" />
                    <ComboBox Margin="0,6,0,0" Width="220" HorizontalAlignment="Left"
                              ItemsSource="{Binding UiLanguageOptions}"
                              SelectedValue="{Binding SelectedUiLanguage}"
                              SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource TranslationKeyConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Content="{Binding SettingsAutoDeviceDetectionText}" IsChecked="{Binding AutoDeviceDetectionEnabled}"
                              FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{Binding SettingsAutoDeviceDetectionHelpText}" />

                    <CheckBox Content="{Binding SettingsStartWithWindowsText}" IsChecked="{Binding StartWithWindows}"
                              FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{Binding SettingsStartWithWindowsHelpText}" />

                    <CheckBox Content="{Binding SettingsStartMinimizedText}" IsChecked="{Binding StartMinimized}"
                              IsEnabled="{Binding StartWithWindows}" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{Binding SettingsStartMinimizedHelpText}" />

                    <CheckBox Content="{Binding SettingsAlwaysOnTopText}" IsChecked="{Binding AlwaysOnTop}"
                              FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{Binding SettingsAlwaysOnTopHelpText}" />

                    <Separator Margin="0,16,0,12" />

                    <TextBlock Text="{loc:LocFormat Key=updates.current_version_format, Value={Binding Update.CurrentVersionText}}"
                               FontWeight="Bold" Margin="0,0,0,8" />

                    <CheckBox Content="{loc:Loc updates.auto_check}" IsChecked="{Binding Update.AutoCheckEnabled}"
                              FontWeight="Bold" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{loc:Loc updates.auto_check_help}" />

                    <CheckBox Content="{loc:Loc updates.include_prereleases}" IsChecked="{Binding Update.IncludePreReleases}"
                              FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{loc:Loc updates.include_prereleases_help}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding Update.CheckForUpdatesCommand}"
                                Padding="8,4" IsEnabled="{Binding Update.IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc updates.check}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{loc:Loc updates.checking}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding Update.IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Update.StatusText}" TextWrapping="Wrap" MaxWidth="500" />

                    <Button Click="RollbackButton_Click" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc updates.change_version}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{loc:Loc updates.change_version_help}" />

                    <Button Command="{Binding Update.OpenUpdateLogCommand}" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc updates.open_log}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{loc:Loc updates.open_log_help}" />

                    <Button Command="{Binding Update.OpenAppDataFolderCommand}" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc updates.open_appdata}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="{loc:Loc updates.open_appdata_help}" />

                    <TextBlock Margin="0,16,0,0" Text="{loc:Loc settings.more_coming}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

    <!-- See the Grid wrapper comment above <DockPanel ...>: last child so it paints on top of everything,
        but IsHitTestVisible="False" (set in the control's constructor) means it never intercepts clicks
        meant for the real UI below it. -->
    <diag:LayoutInspectorOverlay x:Name="InspectorOverlay" />
    </Grid>
</Window>
