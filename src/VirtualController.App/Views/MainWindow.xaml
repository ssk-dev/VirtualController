<Window x:Class="VirtualController.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}" Height="720" Width="1100"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Closing="MainWindow_OnClosing">

    <!-- Ersetzt die native, hell gerenderte und nicht themebare Windows-Titelleiste durch eine eigene,
         dunkle Titelleiste (siehe DockPanel.Dock="Top" TitleBar-Border unten). WindowChrome (Standard-
         WPF-Feature, keine zusaetzliche NuGet-Abhaengigkeit) uebernimmt dabei weiterhin das native
         Verhalten fuer Resize an den Fensterkanten. CaptionHeight="32" markiert den obersten 32px-Streifen
         (identisch zur Hoehe der eigenen TitleBar-Border unten) automatisch als Drag-/Doppelklick-
         Maximieren-Bereich, analog zur nativen Titelleiste - einzelne interaktive Elemente darin (die drei
         Fenstersteuerungs-Buttons) muessen daher explizit per WindowChrome.IsHitTestVisibleInChrome="True"
         als klickbar markiert werden, sonst wuerden ihre Klicks vom Drag-Verhalten geschluckt. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <!-- Eigene, dunkle Titelleiste als Ersatz fuer die native Windows-Titelleiste (siehe
             WindowStyle="None" oben): App-Icon + Titel links, Fenstersteuerung (Minimieren/Maximieren-
             Wiederherstellen/Schliessen) rechts. Der gesamte Bereich fungiert dank WindowChrome
             (CaptionHeight="32") automatisch als Drag-/Doppelklick-Maximieren-Zone; die drei Buttons
             setzen daher explizit WindowChrome.IsHitTestVisibleInChrome="True", damit ihre Klicks nicht
             vom Drag-Verhalten geschluckt werden. Das Maximieren/Wiederherstellen-Glyph wird ueber
             MainWindow.xaml.cs (MaximizeRestoreGlyph) an den aktuellen WindowState angepasst, da ein
             reiner XAML-Trigger auf Window.WindowState hierfuer nicht direkt am Button ansetzen kann. -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/Icons/VirtualController.ico" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding WindowTitle}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeButtonClicked" ToolTip="Minimieren">
                        <TextBlock Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMaximizeRestoreButtonClicked" ToolTip="Maximieren/Wiederherstellen">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseButtonClicked" ToolTip="Schliessen">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kopfzeile: Treiber-Status + globale Aktionen -->
        <Border DockPanel.Dock="Top" Padding="10" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Icons/logo.png" Height="24" Margin="0,0,16,0"
                           VerticalAlignment="Center" />

                    <!-- ViGEmBus-Status als eigene "Pille": Punkt-Indikator + zweizeiliger Text (Haupttext/
                         Untertitel), angelehnt an die urspruengliche Design-Vorlage (assets/layout-mapping.html,
                         ".header-vigembus-box"). -->
                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Background="{StaticResource PanelBackgroundBrush}" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding DriverReady, Converter={StaticResource BoolToStatusBrushConverter}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding DriverStatusText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding DriverReady, Converter={StaticResource BoolToDriverSubtextConverter}}"
                                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding LastErrorMessage}" Foreground="Red" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Platzhalter-Icons (Segoe MDL2 Assets) vor jeder Button-Beschriftung, angelehnt an die
                         Icon-Vorlage in assets/layout-mapping.html; werden spaeter durch eigene Icon-Assets
                         ersetzt. -->
                    <Button Command="{Binding ConnectDriverCommand}" Margin="4,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Treiber verbinden" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshDevicesCommand}" Margin="4,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Geraete aktualisieren" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadProfilesCommand}" Margin="4,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Profile laden" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="12,0,4,0"
                                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#C00000" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ungespeicherte Aenderungen" Foreground="#C00000" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{Binding SaveProfilesCommand}" Margin="4,0" Padding="8,4"
                            Foreground="{Binding HasUnsavedChanges, Converter={StaticResource BoolToUnsavedForegroundConverter}}"
                            FontWeight="{Binding HasUnsavedChanges, Converter={StaticResource BoolToFontWeightConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Profile speichern" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenWindowsGameControllersCommand}" Margin="4,0" Padding="8,4"
                            ToolTip="Oeffnet die native Windows-Systemsteuerung fuer Gamecontroller (joy.cpl).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE975;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Windows Gamecontroller" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Haupt-Tabbar: teilt die Funktionalitaet des Hauptfensters in die Bereiche "Mapping"
             (bisherige Controller-/Modus-/Mapping-Verwaltung, unveraendert), "Gerätekonfiguration"
             (bisheriger separater "Geraete konfigurieren"-Dialog, jetzt als eigener Tab mit einer
             weiteren, inneren Tab-Leiste je Geraet) und "Einstellungen" (Platzhalter fuer zukuenftige,
             globale Anwendungseinstellungen). -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
            <TabItem Header="Mapping">
                <DockPanel>
                    <!-- Linke Spalte: Liste der virtuellen Controller -->
                    <Border DockPanel.Dock="Left" Width="260" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Margin="8" Padding="6" Command="{Binding AddControllerCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Neuer virtueller Controller" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ListBox ItemsSource="{Binding Controllers}"
                                     x:Name="ControllerListBox"
                                     SelectedItem="{Binding SelectedController}"
                                     Margin="4" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CardBorder"
                                                            Background="{StaticResource PanelBackgroundBrush}"
                                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" />
                                                            <TextBlock x:Name="SelectedArrow" Grid.Column="1" Text="&#xE76C;"
                                                                       FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                                                            <Setter TargetName="SelectedArrow" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VirtualControllerViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Layout}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Rechte Seite: Details + Mapping-Tabelle des ausgewaehlten Controllers -->
                    <Grid x:Name="ControllerDetailGrid" DataContext="{Binding SelectedController}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Name:" VerticalAlignment="Center" Width="90" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="220" />

                                    <TextBlock Text="Layout:" VerticalAlignment="Center" Width="60" Margin="16,0,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:VirtualControllerViewModel.LayoutOptions}"
                                              SelectedItem="{Binding Layout}" Width="120"
                                              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                              ToolTip="Das Layout kann nicht geaendert werden, waehrend der Controller laeuft - bitte zuerst Stop klicken." />

                                    <TextBlock Text="Backend:" VerticalAlignment="Center" Width="70" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding ResolvedBackend}" VerticalAlignment="Center" FontStyle="Italic" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Polling (Hz):" VerticalAlignment="Center" Width="90" />
                                    <TextBox Text="{Binding PollingRateHz, UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                    <TextBlock Text="{Binding StatusText}" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />

                                    <Button Command="{Binding StartCommand}" Margin="16,0,4,0" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Start" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding StopCommand}" Margin="4,0" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Sperrt die diesem Controller zugeordneten physischen Geraete per HidHide fuer alle
                                         anderen Anwendungen, solange dieser virtuelle Controller laeuft (siehe
                                         ControllerManager/HidHideController). Ausgegraut, falls der HidHide-Treiber nicht
                                         installiert/betriebsbereit ist (siehe MainViewModel.IsHidHideAvailable) - der
                                         DataContext dieses Bereichs ist bereits SelectedController, daher Zugriff auf das
                                         Fenster-weite MainViewModel ueber den Window-DataContext. -->
                                    <CheckBox Content="HidHide" VerticalAlignment="Center" Margin="16,0,0,0"
                                              IsChecked="{Binding HidHideEnabled}"
                                              IsEnabled="{Binding DataContext.IsHidHideAvailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="Physische Geraete dieses Controllers waehrend der Laufzeit fuer andere Anwendungen sperren (benoetigt den HidHide-Treiber)." />

                                    <Button Command="{Binding RemoveCommand}" Margin="16,0,0,0" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Entfernen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Automatischer Start/Stop dieses Controllers, gekoppelt an das Laufen eines vom
                                     Nutzer ausgewaehlten Programms (Vollpfad-Abgleich per Hintergrund-Polling, siehe
                                     MainViewModel.OnAutoStartTimerTick) - laeuft das Programm, wird der Controller
                                     automatisch gestartet; wird es beendet, automatisch wieder gestoppt. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox Content="Controller automatisch starten" VerticalAlignment="Center"
                                              IsChecked="{Binding AutoStartEnabled}"
                                              ToolTip="Startet und stoppt diesen Controller automatisch, je nachdem ob das unten ausgewaehlte Programm laeuft." />
                                    <Button Command="{Binding ChooseAutoStartExecutableCommand}" Margin="16,0,4,0" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Programm auswählen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding AutoStartExecutableDisplayName}" VerticalAlignment="Center" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Modus-Umschaltmechanismus: entweder ein einziger, controller-weiter Toggle-Trigger, der
                             bei jeder steigenden Flanke zum naechsten aktivierten Modus weiterschaltet, oder je Modus
                             ein eigener Switch-Trigger, der diesen Modus direkt aktiviert (siehe Tab-Leiste unten).
                             Beide Mechanismen sind immer vollstaendig konfiguriert vorhanden - dieser Schalter legt nur
                             fest, welcher davon zur Laufzeit tatsaechlich ausgewertet wird (siehe ControllerSession). -->
                        <Border Grid.Row="1" Padding="12,8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Modi Switch / Toggle:" VerticalAlignment="Center" FontWeight="Bold" Width="130" />
                                <ComboBox ItemsSource="{x:Static vm:VirtualControllerViewModel.ModeSwitchMechanismOptions}"
                                          SelectedItem="{Binding ModeSwitchMechanism}" Width="110" />

                                <!-- Toggle-Trigger wird bewusst direkt neben dem Schalter definiert (nicht in der
                                     Tab-Leiste), da er controller-weit (nicht modusspezifisch) gilt. -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                            Visibility="{Binding ModeSwitchMechanism, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Toggle}">
                                    <Button Command="{Binding CaptureToggleTriggerCommand}" Padding="6,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Erfassen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnAssignToggleTriggerClicked" Padding="6,2" Margin="0,0,6,0"
                                            ToolTip="Physische Eingabe aus einer Liste auswaehlen, statt sie zu druecken/bewegen.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Zuweisen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ToggleTriggerDisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CaptureCountdownSeconds, StringFormat=' (druecke Taste... noch {0}s)'}" Foreground="OrangeRed" VerticalAlignment="Center"
                                               Visibility="{Binding IsCapturingToggleTrigger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Opt-in Bildschirmbenachrichtigung: zeigt bei jedem tatsaechlichen Moduswechsel
                                     dieses Controllers (egal ob per Klick auf einen Tab oder per Trigger) kurz unten
                                     links am Bildschirm den Controller- und Modusnamen an (siehe ModeChangeToast). -->
                                <CheckBox Content="Bildschirmbenachrichtigung bei Moduswechsel" IsChecked="{Binding NotifyOnModeChange}"
                                          VerticalAlignment="Center" Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tab-Leiste der Modi: jeder Tab zeigt Name, gruenen Aktiv-Indikator (nur bei
                             IsActive == true, siehe ModeViewModel), Enabled-Checkbox und Entfernen-Button. Ein Klick
                             auf einen Tab (ausser auf Checkbox/Entfernen) waehlt ihn aus und aktiviert ihn damit
                             sofort als aktiven Modus des Controllers (siehe VirtualControllerViewModel.SelectedMode). -->
                        <Border Grid.Row="2" Padding="8,6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModeViewModel}">
                                            <Border BorderThickness="1" CornerRadius="14" Padding="12,6"
                                                    PreviewMouseLeftButtonDown="OnModeTabBorderPreviewMouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding IsActive, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                             ToolTip="Gruen = dieser Modus ist aktuell der aktive Modus des Controllers." />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                             VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="2,0" />
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                              ToolTip="Deaktivierte Modi werden beim Toggle-/Switch-Wechsel uebersprungen." />

                                                    <!-- Nur bei Switch-Mechanismus relevant: eigener Ausloeser dieses Modus. -->
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                Visibility="{Binding DataContext.ModeSwitchMechanism, ElementName=ControllerDetailGrid, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Switch}">
                                                        <Button Command="{Binding CaptureSwitchTriggerCommand}" Padding="6,2" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Erfassen" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="OnAssignSwitchTriggerClicked" Padding="6,2" Margin="0,0,6,0"
                                                                ToolTip="Physische Eingabe aus einer Liste auswaehlen, statt sie zu druecken/bewegen.">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Zuweisen" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="{Binding SwitchTriggerDisplayName}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding CaptureCountdownSeconds, StringFormat=' (druecke Taste... noch {0}s)'}" Foreground="OrangeRed" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCapturingSwitchTrigger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding SwitchTriggerValidationError}" Foreground="Red" FontWeight="Bold"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="220"
                                                                   Visibility="{Binding SwitchTriggerValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <Button Command="{Binding RemoveCommand}" Padding="4,0" Margin="8,0,0,0"
                                                            ToolTip="Diesen Modus entfernen.">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Command="{Binding AddModeCommand}" Padding="6,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Neuer Modus" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Linke Spalte: Mapping-Tabelle des ausgewaehlten virtuellen Controllers -->
                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                                        Margin="0,0,0,8" Padding="6,4" Command="{Binding AddMappingCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Mapping-Zeile hinzufuegen" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Mapping-Tabelle gruppiert nach Ziel-Typ (Button/Achse/Trigger/D-Pad): statt einer
                                     einzigen flachen DataGrid (frueher x:Name="MappingsDataGrid") wird hier je
                                     Ziel-Typ eine eigene Ueberschrift + DataGrid gerendert (siehe
                                     ModeViewModel.MappingGroups/RebuildMappingGroups). Eine Gruppe erscheint
                                     ausschliesslich, solange ihr mindestens eine Mapping-Zeile zugeordnet ist;
                                     die Reihenfolge der Gruppen entspricht der Reihenfolge der "Ziel-Typ"-
                                     ComboBox-Optionen (MappingRowViewModel.TargetKindOptions). Gruppen sind
                                     bewusst nicht ein-/ausklappbar. Der aeussere ScrollViewer trägt weiterhin
                                     den Namen "MappingsScrollViewer", damit der bestehende Workaround fuer
                                     ComboBox-SelectionChanged (siehe MainWindow.xaml.cs) unveraendert an einem
                                     Vorfahren aller (nun mehreren) DataGrids registriert werden kann - das
                                     Bubbling des Selector.SelectionChangedEvent funktioniert dabei unabhaengig
                                     von der Anzahl/Verschachtelung der dazwischenliegenden ItemsControls. -->
                                <ScrollViewer x:Name="MappingsScrollViewer" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnMappingsScrollViewerPreviewMouseWheel">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Noch nicht zugewiesene Mapping-Zeilen (ModeViewModel.UnassignedMappings): frisch ueber
                                             "+ Mapping-Zeile hinzufuegen" angelegte Zeilen, denen noch keine physische Quelle per
                                             "Erfassen"/"Zuweisen" zugewiesen wurde. Werden bewusst OHNE Ueberschrift und AUSSERHALB
                                             jeder Ziel-Typ-Gruppe ganz oben angezeigt, da sich eine solche Zeile noch nicht sinnvoll
                                             nach Ziel-Typ einordnen laesst - vorher erschien hier stattdessen faelschlicherweise ein
                                             bedeutungsloser Platzhalter wie "- Button 0 (nicht verbunden)" innerhalb der "Button"-
                                             Gruppe. Der gesamte Bereich bleibt unsichtbar, solange keine derartige Zeile existiert. -->
                                        <DataGrid ItemsSource="{Binding SelectedMode.UnassignedMappings, NotifyOnTargetUpdated=True}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  EnableRowVirtualization="False" Margin="0,0,0,16"
                                                  Binding.TargetUpdated="OnMappingsDataGridTargetUpdated"
                                                  Visibility="{Binding SelectedMode.UnassignedMappings.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="{Binding IsSourceActive, Converter={StaticResource BoolToHighlightBrushConverter}}" />
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Physische Quelle" Width="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Command="{Binding CaptureCommand}" Padding="6,2" Margin="0,0,6,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Erfassen" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Click="OnAssignInputClicked" Padding="6,2" Margin="0,0,6,0"
                                                                        ToolTip="Physische Eingabe aus einer Liste auswaehlen, statt sie zu druecken/bewegen.">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Zuweisen" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock Text="{Binding SourceDisplayName}" VerticalAlignment="Center" />
                                                                <TextBlock Text=" (nicht verbunden)" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                <TextBlock Text="{Binding CaptureCountdownSeconds, StringFormat=' (druecke Taste... noch {0}s)'}" Foreground="OrangeRed"
                                                                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Ziel-Typ" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <ComboBox ItemsSource="{x:Static vm:MappingRowViewModel.TargetKindOptions}"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      SelectedItem="{Binding SelectedTargetKind}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Ziel-Wert" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <ComboBox ItemsSource="{Binding CurrentTargetOptions}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      SelectedValue="{Binding SelectedTargetValue}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Invertieren" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <CheckBox IsChecked="{Binding Invert}" HorizontalAlignment="Center"
                                                                      Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Nur diese Richtung" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <CheckBox IsChecked="{Binding DirectionalOnly}" HorizontalAlignment="Center"
                                                                      ToolTip="Nur die erfasste Achsenhaelfte (z.B. Y+) auf diese Ziel-Achse anwenden, statt der vollen Achse - ermoeglicht das Aufteilen zweier physischer Achsenhaelften auf unterschiedliche virtuelle Achsen."
                                                                      Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="" Width="90">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                            <Button Command="{Binding RemoveCommand}" Padding="6,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Entfernen" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <ItemsControl ItemsSource="{Binding SelectedMode.MappingGroups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MappingGroupViewModel}">
                                                    <StackPanel Margin="0,0,0,16">
                                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />

                                                        <DataGrid ItemsSource="{Binding Rows, NotifyOnTargetUpdated=True}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  EnableRowVirtualization="False"
                                                                  Binding.TargetUpdated="OnMappingsDataGridTargetUpdated">
                                                            <DataGrid.RowStyle>
                                                                <!-- Live-Hervorhebung der Mapping-Zeile, waehrend ihre zugewiesene physische
                                                                     Quelle gerade aktiv ist (Taste gedrueckt, Achse ausgeschlagen, D-Pad
                                                                     gehalten) - identisches Verhalten wie in der Liste "Verfügbare Geräte"
                                                                     (siehe PhysicalInputRowViewModel.IsActive), nur hier fuer die komplette
                                                                 Zeile der Mapping-Tabelle statt fuer eine einzelne Eingabezeile. -->
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="Background" Value="{Binding IsSourceActive, Converter={StaticResource BoolToHighlightBrushConverter}}" />
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Header="Physische Quelle" Width="220">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Button Command="{Binding CaptureCommand}" Padding="6,2" Margin="0,0,6,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="Erfassen" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Click="OnAssignInputClicked" Padding="6,2" Margin="0,0,6,0"
                                                                                    ToolTip="Physische Eingabe aus einer Liste auswaehlen, statt sie zu druecken/bewegen.">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="Zuweisen" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <TextBlock Text="{Binding SourceDisplayName}" VerticalAlignment="Center" />
                                                                            <TextBlock Text=" (nicht verbunden)" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"
                                                                                       Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                            <TextBlock Text="{Binding CaptureCountdownSeconds, StringFormat=' (druecke Taste... noch {0}s)'}" Foreground="OrangeRed"
                                                                                       Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="Ziel-Typ" Width="110">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <ComboBox ItemsSource="{x:Static vm:MappingRowViewModel.TargetKindOptions}"
                                                                                  IsSynchronizedWithCurrentItem="False"
                                                                                  SelectedItem="{Binding SelectedTargetKind}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="Ziel-Wert" Width="150">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <ComboBox ItemsSource="{Binding CurrentTargetOptions}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  IsSynchronizedWithCurrentItem="False"
                                                                                  SelectedValue="{Binding SelectedTargetValue}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="Invertieren" Width="80">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <CheckBox IsChecked="{Binding Invert}" HorizontalAlignment="Center"
                                                                                  Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="Nur diese Richtung" Width="80">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <CheckBox IsChecked="{Binding DirectionalOnly}" HorizontalAlignment="Center"
                                                                                  ToolTip="Nur die erfasste Achsenhaelfte (z.B. Y+) auf diese Ziel-Achse anwenden, statt der vollen Achse - ermoeglicht das Aufteilen zweier physischer Achsenhaelften auf unterschiedliche virtuelle Achsen."
                                                                                  Visibility="{Binding IsAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTemplateColumn Header="" Width="90">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                                                                        <Button Command="{Binding RemoveCommand}" Padding="6,2">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Entfernen" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            </DockPanel>

                            <!-- Rechte Spalte: vertikales Panel mit allen fuer diesen Controller verfuegbaren physischen Geraeten -->
                            <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Verfügbare Geräte:" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                        <ItemsControl ItemsSource="{Binding AvailableDeviceSelections}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DeviceSelectionViewModel}">
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4"
                                                              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                                                        <Expander.Header>
                                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                                                      VerticalContentAlignment="Center" />
                                                        </Expander.Header>

                                                        <ItemsControl ItemsSource="{Binding Inputs}" Margin="24,4,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:PhysicalInputRowViewModel}">
                                                                    <Border Background="{Binding IsActive, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                                                            Padding="4,2" Margin="0,0,0,1"
                                                                            Opacity="{Binding IsEnabled, Converter={StaticResource BoolToDimOpacityConverter}}">
                                                                        <StackPanel>
                                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                     VerticalAlignment="Center" />
                                                                            <Button Command="{Binding AssignCommand}"
                                                                                    HorizontalAlignment="Left" Padding="6,1" Margin="0,4,0,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="Zuweisen" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Zugewiesene, aber aktuell nicht angeschlossene Geraete: rein informativ und
                                             ausgegraut (analog zur Live-Hervorhebung in "Verfügbare Geräte", nur invertiert
                                             und dauerhaft), damit die bestehende Zuweisung sichtbar bleibt, ohne dass der
                                             Nutzer sie mit tatsaechlich angeschlossenen Geraeten verwechseln kann. Nur
                                             sichtbar, solange mindestens ein zugewiesenes Geraet getrennt ist. -->
                                        <TextBlock Text="Zugewiesene Geräte:" FontWeight="Bold" Margin="0,12,0,4"
                                                   Visibility="{Binding AssignedDisconnectedDeviceSelections.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                                        <ItemsControl ItemsSource="{Binding AssignedDisconnectedDeviceSelections}"
                                                      Visibility="{Binding AssignedDisconnectedDeviceSelections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AssignedDisconnectedDeviceViewModel}">
                                                    <TextBlock Text="{Binding DisplayName}" Margin="0,0,0,4" Opacity="0.4"
                                                               ToolTip="Diesem Controller zugeordnet, aber aktuell nicht angeschlossen." />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Gerätekonfiguration">
                <!-- DataContext dieses Tabs ist bewusst explizit auf DeviceConfig umgebogen (statt weiter
                     auf MainViewModel zu zeigen wie die Tab-Leiste selbst), damit alle Bindings innerhalb
                     dieses Tabs (Devices/SelectedDevice) direkt gegen das DeviceConfigViewModel aufloesen -
                     analog dazu, wie zuvor DeviceConfigWindow.xaml komplett eigenstaendig an dieses
                     ViewModel gebunden war. -->
                <DockPanel DataContext="{Binding DeviceConfig}">
                    <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8" TextWrapping="Wrap"
                               Text="Deaktivierte Geraete erscheinen in keiner Geraeteauswahl mehr. Deaktivierte Eingaben werden von Erfassung und Mapping ignoriert, bleiben aber hier sichtbar. Ueber 'Ausblenden' laesst sich ein Geraet (z.B. ein eigener virtueller Controller dieser Anwendung) komplett aus dieser Liste entfernen - ausgeblendete Geraete koennen unten wieder eingeblendet werden." />

                    <!-- Linke Spalte: Liste aller bekannten physischen Geraete (verbunden + zuvor bekannte,
                         aber aktuell getrennte - siehe MainViewModel.GetAllKnownDevices), analog zur
                         Controller-Liste im "Mapping"-Tab. Ersetzt die fruehere innere Tab-Leiste
                         (TabStripPlacement="Left") durch dasselbe Listen+Detail-Muster wie im Mapping-Tab,
                         fuer ein konsistentes Erscheinungsbild. Der gruene/graue Status-Punkt zeigt
                         Enabled+Connected (gruen) vs. deaktiviert/getrennt (grau); der Geraetename wird
                         zusaetzlich ausgegraut, wenn das Geraet aktuell nicht angeschlossen ist - beide
                         Zustaende sind unabhaengig voneinander und koennen sich ueberlagern. Unterhalb der
                         Hauptliste ermoeglicht ein einklappbarer Bereich das Wiedereinblenden manuell
                         ausgeblendeter Geraete (siehe DeviceSettings.Hidden) - notwendig, da z.B. die
                         eigenen, per ViGEmBus emulierten virtuellen Controller dieser Anwendung von
                         XInput/DirectInput nicht automatisch von echter Hardware unterschieden werden
                         koennen und der Nutzer sie daher selbst dauerhaft ausblenden muss. -->
                    <Border DockPanel.Dock="Left" Width="260" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Expander DockPanel.Dock="Bottom" Header="Ausgeblendete Geräte" Margin="4"
                                      Visibility="{Binding HiddenDevices.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ListBox ItemsSource="{Binding HiddenDevices}" MaxHeight="200" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
                                            <Grid Margin="2" Opacity="{Binding IsConnected, Converter={StaticResource BoolToDimOpacityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Padding="4,1" FontSize="11"
                                                        Command="{Binding ToggleHiddenCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Einblenden" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>

                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
                                        <Grid Margin="2" Opacity="{Binding IsConnected, Converter={StaticResource BoolToDimOpacityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsActiveIndicator, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                     ToolTip="Gruen = aktiviert und angeschlossen. Grau = deaktiviert und/oder nicht angeschlossen." />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Padding="4,1" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding ToggleHiddenCommand}"
                                                    ToolTip="Dieses Geraet dauerhaft aus dieser Liste entfernen (z.B. einen eigenen virtuellen Controller) - jederzeit unten wieder einblendbar.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Ausblenden" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Rechte Seite: Detailansicht des ausgewaehlten Geraets, ueber die implizite
                         DeviceConfigDeviceViewModel-Vorlage (siehe DeviceConfigTemplates.xaml) dargestellt. -->
                    <ContentPresenter Content="{Binding SelectedDevice}" Margin="8,0,8,8" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Einstellungen">
                <StackPanel Margin="12">
                    <CheckBox Content="Automatische Geräteerkennung" IsChecked="{Binding AutoDeviceDetectionEnabled}"
                              FontWeight="Bold" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Erkennt neu angeschlossene oder getrennte Geräte automatisch im Hintergrund, ohne dass 'Geräte aktualisieren' geklickt werden muss. Deaktivieren stoppt den periodischen Scan vollständig." />

                    <Separator Margin="0,16,0,12" />

                    <TextBlock Text="{Binding Update.CurrentVersionText, StringFormat='Aktuell installierte Version: {0}'}"
                               FontWeight="Bold" Margin="0,0,0,8" />

                    <CheckBox Content="Automatisch auf Updates prüfen" IsChecked="{Binding Update.AutoCheckEnabled}"
                              FontWeight="Bold" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Prüft bei jedem Start der Anwendung automatisch, ob eine neuere Version verfügbar ist. Bei fehlender Internetverbindung wird die Anwendung dadurch nicht beeinträchtigt." />

                    <CheckBox Content="Auch Vorabversionen berücksichtigen" IsChecked="{Binding Update.IncludePreReleases}"
                              FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Margin="24,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Bezieht bei der Update-Prüfung auch als Pre-release markierte Versionen ein (z.B. Tags mit dem Suffix '-alpha', '-beta' oder '-nightly'), statt ausschließlich vollwertige, stabile Versionen anzubieten." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding Update.CheckForUpdatesCommand}"
                                Padding="8,4" IsEnabled="{Binding Update.IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Auf Updates prüfen" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Prüfung läuft..." Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding Update.IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Update.StatusText}" TextWrapping="Wrap" MaxWidth="500" />

                    <Button Click="RollbackButton_Click" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Version wechseln..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Ermöglicht den gezielten Wechsel zu einer beliebigen verfügbaren Version, einschließlich älterer Versionen (Rollback)." />

                    <Button Command="{Binding Update.OpenUpdateLogCommand}" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Update-Log öffnen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Öffnet das Update-Protokoll (Download, Kopieren der neuen Dateien, Neustart) zur genauen Analyse, falls ein Update-Vorgang unerwartet verlaufen ist." />

                    <Button Command="{Binding Update.OpenAppDataFolderCommand}" Padding="8,4"
                            Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="AppData-Ordner öffnen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="500"
                               Text="Öffnet den Anwendungsdatenordner (%AppData%\VirtualController) im Explorer, mit allen gespeicherten Profilen, Geräte-Einstellungen und Protokolldateien." />

                    <TextBlock Margin="0,16,0,0" Text="Hier entstehen zukuenftig weitere globale Anwendungseinstellungen." Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
