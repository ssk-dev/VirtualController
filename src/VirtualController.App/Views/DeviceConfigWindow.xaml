<Window x:Class="VirtualController.App.Views.DeviceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
        xmlns:controls="clr-namespace:VirtualController.App.Views.Controls"
        Title="Geraete konfigurieren" Height="560" Width="520"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Implizite DataTemplates (kein x:Key): WPF waehlt automatisch die passende Vorlage anhand
             des Laufzeittyps der jeweiligen Visualisierungs-Instanz aus - Einzelachsen als horizontaler
             Slider, kombinierte X/Y-Achsen als quadratisches Koordinatenfeld. Jede Achsen-/Stick-Karte
             bindet ihre eigene ContentPresenter.Content="{Binding Visualization}" direkt eingebettet
             (statt, wie zuvor, alle Achsen gesammelt in einem separaten globalen "Live-Vorschau"-Abschnitt
             anzuzeigen) - so ist die Live-Anzeige unmittelbar bei der zugehoerigen Achse sichtbar. -->
        <DataTemplate DataType="{x:Type vm:AxisVisualizationViewModel}">
            <controls:AxisGaugeControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Axis2DVisualizationViewModel}">
            <controls:Axis2DPadControl />
        </DataTemplate>

        <!-- Detaildarstellung einer einzelnen physischen Eingabe (Name/Enable + bei kalibrierbaren
             Achsen-Eintraegen zusaetzlich die Kalibrierungs-Werkzeuge). Als implizites Template (statt
             als expliziter ItemTemplate) registriert, damit es sowohl von der flachen Buttons/D-Pad-Liste
             (DeviceConfigInputGroupViewModel) als auch vom Achsen-Paar-Frame (DeviceConfigAxisPairViewModel)
             gemeinsam per ContentPresenter/ItemsControl automatisch anhand des Laufzeittyps wiederverwendet
             werden kann. -->
        <DataTemplate DataType="{x:Type vm:DeviceConfigInputRowViewModel}">
            <Border Background="{Binding IsActive, Converter={StaticResource BoolToHighlightBrushConverter}}"
                    Padding="4,2" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Width="248" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="24,0,0,0"
                                Visibility="{Binding IsCalibratable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Button Content="Bereich kalibrieren" Command="{Binding CalibrateRangeCommand}" Padding="6,1" Margin="0,0,4,0" />
                            <Button Content="Zentrum setzen" Command="{Binding SetCenterCommand}" Padding="6,1" Margin="0,0,4,0" />
                            <Button Content="Deadzone kalibrieren" Command="{Binding CalibrateDeadzoneCommand}" Padding="6,1" Margin="0,0,4,0" />
                            <Button Content="Zuruecksetzen" Command="{Binding ResetCalibrationCommand}" Padding="6,1" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Min:" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock Text="{Binding CalibratedMin, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                            <TextBlock Text="Max:" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBlock Text="{Binding CalibratedMax, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                            <TextBlock Text="Zentrum:" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBlock Text="{Binding CalibratedCenter, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                            <TextBlock Text="Deadzone:" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBox Text="{Binding Deadzone, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Kurve:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{x:Static vm:DeviceConfigInputRowViewModel.CurveTypeOptions}"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectedItem="{Binding CurveType}" Width="100" Margin="0,0,8,0" />
                            <TextBlock Text="Staerke:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding CurveStrength, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        </StackPanel>

                        <TextBlock Text="{Binding CalibrationStatus}" Foreground="Gray" FontStyle="Italic"
                                   Margin="0,2" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Flache Eingabe-Gruppe (Buttons, D-Pad): Ueberschrift + Liste der Zeilen, jede Zeile per obigem
             implizitem DeviceConfigInputRowViewModel-Template dargestellt. -->
        <DataTemplate DataType="{x:Type vm:DeviceConfigInputGroupViewModel}">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,3" />
                <ItemsControl ItemsSource="{Binding Inputs}" Margin="12,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Ein Achsen-Paar (Positiv-/Negativ-Richtung derselben physischen Achse) als optisch klar
             abgegrenzter Rahmen: beide Richtungen stehen direkt untereinander, darunter (nur unterhalb des
             Positiv-Eintrags, siehe DeviceConfigInputRowViewModel.IsCalibratable) die Kalibrierungs-
             Werkzeuge. Der Rahmen macht auf einen Blick erkennbar, welche Zeilen zur selben Achse gehoeren -
             zuvor standen Positiv-/Negativ-Eintraege optisch nicht unterscheidbar von unabhaengigen Buttons. -->
        <DataTemplate DataType="{x:Type vm:DeviceConfigAxisPairViewModel}">
            <Border BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4"
                    Background="#FAFAFA" Padding="6,4" Margin="0,0,0,8" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- Eigenstaendiger Master-Schalter fuer die komplette Achse (beide Richtungen
                         zugleich) - wird ausgeblendet, wenn diese Achse Teil eines Sticks ist, dessen
                         Kopfbereich bereits einen einzigen kombinierten Schalter fuer beide Achsen anbietet.
                         Tri-State (IsThreeState), da bei nur einer deaktivierten Richtung ein rein binaerer
                         Haken faelschlich "komplett aus" suggerieren wuerde; das eigentliche Umschalten
                         erfolgt ueber Command statt einer direkten IsChecked-Bindung, damit ein Klick immer
                         beide Richtungen auf denselben expliziten Wert setzt statt durch den dritten
                         (unbestimmten) Zustand zu zyklen. -->
                    <CheckBox IsChecked="{Binding EnabledState, Mode=OneWay}" IsThreeState="True"
                              Command="{Binding ToggleEnabledCommand}" Content="Achse aktivieren"
                              Margin="0,0,0,4" ToolTip="Komplette Achse (beide Richtungen) aktivieren/deaktivieren"
                              Visibility="{Binding ShowMasterToggle, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel>
                        <ContentPresenter Content="{Binding Positive}" />
                        <ContentPresenter Content="{Binding Negative}"
                                          Visibility="{Binding HasNegative, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ContentPresenter Content="{Binding Visualization}" HorizontalAlignment="Stretch"
                                          Margin="0,2,0,0" IsEnabled="{Binding IsAnyEnabled}"
                                          Visibility="{Binding HasVisualization, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Ein kompletter Stick (zwei zusammengehoerige Achsen, z.B. "Linker Stick" = X+Y): rahmt beide
             Achsen-Paare (je per obigem impliziten DeviceConfigAxisPairViewModel-Template) gemeinsam in
             einem staerker hervorgehobenen Rahmen ein, mit Stick-Name und einem einzigen
             "Stick deaktivieren"-Schalter im Kopfbereich, der alle vier zugrunde liegenden Positiv-/
             Negativ-Zeilen zugleich (de-)aktiviert - der Nutzer muss dafuer nicht mehr jede der vier
             Einzelrichtungen separat abhaken. -->
        <DataTemplate DataType="{x:Type vm:DeviceConfigStickGroupViewModel}">
            <Border BorderBrush="#B0B0B0" BorderThickness="2" CornerRadius="6"
                    Background="White" Padding="8" Margin="0,0,0,10" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- Tri-State, da bei nur einer deaktivierten Richtung (z.B. Y+) ein rein
                             binaerer Haken faelschlich "kompletter Stick aus" suggerieren wuerde; das
                             eigentliche Umschalten erfolgt ueber Command statt einer direkten
                             IsChecked-Bindung, damit ein Klick immer alle vier Richtungen auf denselben
                             expliziten Wert setzt statt durch den dritten (unbestimmten) Zustand zu zyklen. -->
                        <CheckBox IsChecked="{Binding EnabledState, Mode=OneWay}" IsThreeState="True"
                                  Command="{Binding ToggleEnabledCommand}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTip="Kompletten Stick aktivieren/deaktivieren" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Width="200" />
                    </StackPanel>

                    <!-- X/Y-Achsen bleiben stets eigenstaendig bedienbar (jede Richtung hat ihre eigene
                         Checkbox) - nur die Kalibrierungs-Werkzeuge und die Live-Vorschau (ohne eigenen
                         Schalter) werden ausgegraut, wenn der Stick oben komplett deaktiviert wird. Wuerde
                         man IsEnabled hier auf den gesamten Bereich (inkl. X/Y-Zeilen) anwenden, wuerde das
                         Deaktivieren einer einzelnen Richtung ueber die Enabled-Kaskade (Achse -> Stick)
                         auch die noch aktive Gegenachse mitsperren.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" x:Name="StickAxesColumn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="X" FontWeight="Bold" FontSize="20" Width="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" />
                                <ContentPresenter Content="{Binding XAxis}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Y" FontWeight="Bold" FontSize="20" Width="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" />
                                <ContentPresenter Content="{Binding YAxis}" />
                            </StackPanel>

                            <!-- Kombinierte Kalibrierung fuer X und Y gleichzeitig, damit der Nutzer den
                                 Stick nur einmal bewegen muss statt jede Achse einzeln zu kalibrieren. -->
                            <StackPanel Margin="24,4,0,0" IsEnabled="{Binding IsAnyEnabled}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Content="Bereich kalibrieren" Command="{Binding CalibrateRangeCommand}" Padding="6,1" Margin="0,0,4,0" />
                                    <Button Content="Zentrum setzen" Command="{Binding SetCenterCommand}" Padding="6,1" Margin="0,0,4,0" />
                                    <Button Content="Deadzone kalibrieren" Command="{Binding CalibrateDeadzoneCommand}" Padding="6,1" Margin="0,0,4,0" />
                                    <Button Content="Zuruecksetzen" Command="{Binding ResetCalibrationCommand}" Padding="6,1" />
                                </StackPanel>
                                <TextBlock Text="{Binding CalibrationStatus}" Foreground="Gray" FontStyle="Italic"
                                           Margin="0,2" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <ContentPresenter Grid.Column="1" Content="{Binding Visualization}" Margin="8,0,0,0"
                                          Height="{Binding ActualHeight, ElementName=StickAxesColumn}"
                                          VerticalAlignment="Top" HorizontalAlignment="Stretch" IsEnabled="{Binding IsAnyEnabled}"
                                          Visibility="{Binding HasVisualization, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Achsen-Gruppe: Ueberschrift + Liste der Achsen-Elemente (entweder eigenstaendige Achsen-Paare
             oder komplette Sticks aus zwei gepaarten Achsen), jedes Element per obigem passendem impliziten
             Template (Rahmen) dargestellt. -->
        <DataTemplate DataType="{x:Type vm:DeviceConfigAxisGroupViewModel}">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,3" />
                <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Deaktivierte Geraete erscheinen in keiner Geraeteauswahl mehr. Deaktivierte Eingaben werden von Erfassung und Mapping ignoriert, bleiben aber hier sichtbar." />

        <Button DockPanel.Dock="Bottom" Content="Schliessen" HorizontalAlignment="Right"
                Margin="0,8,0,0" Padding="16,4" IsCancel="True" Click="OnCloseClicked" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6"
                                  BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="Bold" />
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="24,4,0,0" IsEnabled="{Binding Enabled}">
                                <ItemsControl ItemsSource="{Binding InputGroups}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
