<Window x:Class="VirtualController.App.Views.RollbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Version wechseln" Height="420" Width="440"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- Dialog "Version wechseln" (siehe RollbackDialog.xaml.cs): zeigt ALLE an der Update-Quelle
         verfuegbaren Versionen zur Auswahl an - im Gegensatz zum regulaeren Update-Popup
         (UpdateAvailableDialog) erlaubt dieser Dialog explizit auch den Wechsel zu einer AELTEREN Version
         (Rollback). Waehrend des Ladens der Versionsliste (IsLoading) bzw. einer laufenden Installation
         (IsInstalling) sind Liste und Buttons entsprechend deaktiviert. -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Version wechseln" FontSize="16" FontWeight="Bold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Wählen Sie eine Version aus, zu der gewechselt werden soll. Dies funktioniert auch für ältere Versionen (Rollback)." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="Version installieren" Command="{Binding InstallCommand}" Padding="8,4" IsDefault="True"
                    FontWeight="Bold" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                   Text="Versionen werden geladen..."
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="Red" TextWrapping="Wrap"
                   Text="{Binding LoadErrorText}"
                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Minimum="0" Maximum="100" Height="16" Value="{Binding InstallProgressPercent, Mode=OneWay}" />
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding InstallStepText}" />
        </StackPanel>

        <ListBox Margin="0,14,0,0" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                  DisplayMemberPath="DisplayText"
                  IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" />
    </DockPanel>
</Window>
