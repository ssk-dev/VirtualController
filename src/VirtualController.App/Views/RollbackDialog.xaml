<Window x:Class="VirtualController.App.Views.RollbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VirtualController.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc rollback.title}" Height="420" Width="440"
        Icon="pack://application:,,,/Icons/VirtualController.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None">

    <!-- Dark title bar replacement for the native bright Windows title bar (see MainWindow.xaml for the
         same pattern). WindowStyle="None" removes the system chrome; WindowChrome provides drag and
         double-click-to-maximize behavior for the custom title bar area below. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <DockPanel Margin="0">
        <!-- Custom dark title bar -->
        <Border DockPanel.Dock="Top" Height="32" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseButtonClicked"
                            ToolTip="{loc:Loc window.close}">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- "Change version" dialog (see RollbackDialog.xaml.cs) that lists every version available from the
            update source. Unlike the regular update dialog (UpdateAvailableDialog), it also allows switching
            to an older version (rollback). The list and buttons are disabled while versions are loading
            (IsLoading) or an installation is running (IsInstalling). -->
        <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc rollback.title}" FontSize="16" FontWeight="Bold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{loc:Loc rollback.message}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="{loc:Loc rollback.install}" Command="{Binding InstallCommand}" Padding="8,4" IsDefault="True"
                    FontWeight="Bold" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                   Text="{loc:Loc rollback.loading}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="Red" TextWrapping="Wrap"
                   Text="{Binding LoadErrorText}"
                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Minimum="0" Maximum="100" Height="16" Value="{Binding InstallProgressPercent, Mode=OneWay}" />
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding InstallStepText}" />
            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" TextWrapping="Wrap"
                       Text="{loc:Loc update_dialog.restarting}"
                       Visibility="{Binding IsRestarting, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <ListBox Margin="0,14,0,0" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                  DisplayMemberPath="DisplayText"
                  IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" />
        </DockPanel>
    </DockPanel>
</Window>
