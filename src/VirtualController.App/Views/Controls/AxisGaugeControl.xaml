<UserControl x:Class="VirtualController.App.Views.Controls.AxisGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AxisVisualizationViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="160">
    <!--
        Generic, read-only live display of one physical axis as a horizontal bar/slider. The DataContext is
        always an AxisVisualizationViewModel. All positions (marker and deadzone band) are calculated relative
        to the actual width only through Grid star columns (FractionToStarGridLengthConverter); there is no
        custom pixel arithmetic or value logic.
    -->
    <StackPanel Margin="0,2,0,4">
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat=F2}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
        </Grid>

        <Border Height="20" CornerRadius="3" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Deadzone band: centered region whose width is proportional to the configured deadzone. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding DeadzoneStartFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding DeadzoneWidthFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding AfterDeadzoneFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DeadzoneBand" Grid.Column="1" Margin="0,3" CornerRadius="2"
                            BorderThickness="1" BorderBrush="{StaticResource PanelBorderBrush}" Background="{StaticResource ButtonHoverBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                     <!-- Fires only on the transition from inside to outside (EnterActions), not
                                         continuously while the state persists, avoiding flicker. -->
                                    <DataTrigger Binding="{Binding IsOutsideDeadzone}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="#FFA726" Duration="0:0:0.12" AutoReverse="True" />
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#FFE0B2" Duration="0:0:0.12" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <!-- Center marker, meaningful only for bidirectional (centered) axes. -->
                <Rectangle Width="1" Fill="{StaticResource MutedTextBrush}"
                           Visibility="{Binding IsBidirectional, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Current value as a narrow, visible bar/marker. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding MarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="{Binding AfterMarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="1" Fill="#2D6CDF" RadiusX="1" RadiusY="1" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
