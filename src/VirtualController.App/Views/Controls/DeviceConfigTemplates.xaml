<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
                    xmlns:loc="clr-namespace:VirtualController.App.Localization"
                    xmlns:controls="clr-namespace:VirtualController.App.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
           <!-- Required to resolve the StaticResource converter and brush references used below at runtime.
               StaticResource references in templates are resolved in the scope of THIS file and its own
               MergedDictionaries, not App.xaml, even when App.xaml merges this dictionary. Without these
               dictionaries, the app threw a XamlParseException when first rendering the Device Configuration tab. -->
        <ResourceDictionary Source="/Converters/Converters.xaml" />
        <ResourceDictionary Source="/Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

        <!-- Implicit DataTemplates (no x:Key) for the Device Configuration tab (see MainWindow.xaml). WPF selects
            the template from each visualization's runtime type: individual axes use a horizontal slider, while
            combined X/Y axes use a square coordinate field. Each axis/stick card embeds its own
            ContentPresenter.Content="{Binding Visualization}" rather than collecting all axes in a separate
            global preview section, keeping the live display beside its corresponding axis. Originally defined
            in DeviceConfigWindow.xaml, these templates were moved here so MainWindow.xaml can reuse them. -->
    <DataTemplate DataType="{x:Type vm:AxisVisualizationViewModel}">
        <controls:AxisGaugeControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:Axis2DVisualizationViewModel}">
        <controls:Axis2DPadControl />
    </DataTemplate>

        <!-- Details for one physical input (name/enabled state, plus calibration tools for calibratable axes).
            Registered as an implicit template so both the flat button/D-pad list
            (DeviceConfigInputGroupViewModel) and axis-pair frame (DeviceConfigAxisPairViewModel) can reuse it
            through ContentPresenter/ItemsControl based on runtime type. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigInputRowViewModel}">
        <Border Background="{Binding IsActive, Converter={StaticResource BoolToHighlightBrushConverter}}"
                Padding="4,2" Margin="0,0,0,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Width="248" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="24,0,0,0"
                            Visibility="{Binding IsCalibratable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="{loc:Loc devices.calibrate_range}" Command="{Binding CalibrateRangeCommand}" Padding="6,1" Margin="0,0,4,0" />
                        <Button Content="{loc:Loc devices.set_center}" Command="{Binding SetCenterCommand}" Padding="6,1" Margin="0,0,4,0" />
                        <Button Content="{loc:Loc devices.calibrate_deadzone}" Command="{Binding CalibrateDeadzoneCommand}" Padding="6,1" Margin="0,0,4,0" />
                        <Button Content="{loc:Loc devices.reset}" Command="{Binding ResetCalibrationCommand}" Padding="6,1" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{loc:Loc devices.min}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <TextBlock Text="{Binding CalibratedMin, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                        <TextBlock Text="{loc:Loc devices.max}" VerticalAlignment="Center" Margin="8,0,2,0" />
                        <TextBlock Text="{Binding CalibratedMax, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                        <TextBlock Text="{loc:Loc devices.center}" VerticalAlignment="Center" Margin="8,0,2,0" />
                        <TextBlock Text="{Binding CalibratedCenter, TargetNullValue='-'}" VerticalAlignment="Center" Width="50" />
                        <TextBlock Text="{loc:Loc devices.deadzone}" VerticalAlignment="Center" Margin="8,0,2,0" />
                        <TextBox Text="{Binding Deadzone, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{loc:Loc devices.curve}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{x:Static vm:DeviceConfigInputRowViewModel.CurveTypeOptions}"
                                  IsSynchronizedWithCurrentItem="False"
                                  SelectedItem="{Binding CurveType}" Width="100" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc devices.strength}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding CurveStrength, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    </StackPanel>

                    <TextBlock Text="{Binding CalibrationStatus}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                               Margin="0,2" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

        <!-- Flat input group (buttons, D-pad): heading and row list, with each row rendered by the implicit
            DeviceConfigInputRowViewModel template above. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigInputGroupViewModel}">
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding Inputs}" Margin="12,0,0,0" />
        </StackPanel>
    </DataTemplate>

        <!-- A physical axis pair (positive and negative directions) in a distinct frame, with both directions
            stacked above the calibration tools (shown only below the positive entry; see
            DeviceConfigInputRowViewModel.IsCalibratable). The frame makes it clear which rows belong to the
            same axis; previously they looked like unrelated buttons. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigAxisPairViewModel}">
        <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4"
                Background="Transparent" Padding="6,4" Margin="0,0,0,8" HorizontalAlignment="Left">
            <StackPanel>
                 <!-- Standalone master switch for both axis directions. Hidden when this axis belongs to a
                     stick whose header already provides a combined switch for both axes. Uses three states
                     because a binary checkmark would incorrectly imply the whole axis is off when only one
                     direction is disabled. The command, rather than a direct IsChecked binding, ensures one
                     click sets both directions to the same explicit value instead of cycling through the
                     indeterminate state. -->
                <CheckBox IsChecked="{Binding EnabledState, Mode=OneWay}" IsThreeState="True"
                          Command="{Binding ToggleEnabledCommand}" Content="{loc:Loc devices.enable_axis}"
                          Margin="0,0,0,4" ToolTip="{loc:Loc devices.enable_axis_tooltip}"
                          Visibility="{Binding ShowMasterToggle, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel>
                    <ContentPresenter Content="{Binding Positive}" />
                    <ContentPresenter Content="{Binding Negative}"
                                      Visibility="{Binding HasNegative, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ContentPresenter Content="{Binding Visualization}" HorizontalAlignment="Stretch"
                                      Margin="0,2,0,0" IsEnabled="{Binding IsAnyEnabled}"
                                      Visibility="{Binding HasVisualization, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

        <!-- A complete stick (two related axes, e.g. "Left stick" = X+Y) groups both axis pairs in a highlighted
            frame. Its header contains the stick name and one switch for all four positive/negative rows, so
            users do not have to toggle each direction individually. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigStickGroupViewModel}">
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"
                Background="Transparent" Padding="8" Margin="0,0,0,10" HorizontalAlignment="Left">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <!-- Three states are needed because a binary checkmark would incorrectly imply the entire
                         a binary checkmark would incorrectly imply the complete stick is disabled. The
                         command, rather than a direct IsChecked binding, ensures one click sets all four
                         directions to the same explicit value instead of cycling through the indeterminate state. -->
                    <CheckBox IsChecked="{Binding EnabledState, Mode=OneWay}" IsThreeState="True"
                              Command="{Binding ToggleEnabledCommand}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="{loc:Loc devices.enable_stick_tooltip}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Width="200" />
                </StackPanel>

                 <!-- Keep X/Y axes independently editable (each direction has its own checkbox). Only the
                     calibration tools and live preview, which have no separate switch, are dimmed when the
                     entire stick is disabled above. Applying IsEnabled to this whole area would cascade an
                     individual direction's disabled state up to the stick and incorrectly disable its active
                     counterpart.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" x:Name="StickAxesColumn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X" FontWeight="Bold" FontSize="20" Width="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                            <ContentPresenter Content="{Binding XAxis}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Y" FontWeight="Bold" FontSize="20" Width="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                            <ContentPresenter Content="{Binding YAxis}" />
                        </StackPanel>

                            <!-- Calibrate X and Y together so the user only needs to move the stick once. -->
                        <StackPanel Margin="24,4,0,0" IsEnabled="{Binding IsAnyEnabled}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Content="{loc:Loc devices.calibrate_range}" Command="{Binding CalibrateRangeCommand}" Padding="6,1" Margin="0,0,4,0" />
                                <Button Content="{loc:Loc devices.set_center}" Command="{Binding SetCenterCommand}" Padding="6,1" Margin="0,0,4,0" />
                                <Button Content="{loc:Loc devices.calibrate_deadzone}" Command="{Binding CalibrateDeadzoneCommand}" Padding="6,1" Margin="0,0,4,0" />
                                <Button Content="{loc:Loc devices.reset}" Command="{Binding ResetCalibrationCommand}" Padding="6,1" />
                            </StackPanel>
                            <TextBlock Text="{Binding CalibrationStatus}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                                       Margin="0,2" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ContentPresenter Grid.Column="1" Content="{Binding Visualization}" Margin="8,0,0,0"
                                      Height="{Binding ActualHeight, ElementName=StickAxesColumn}"
                                      VerticalAlignment="Top" HorizontalAlignment="Stretch" IsEnabled="{Binding IsAnyEnabled}"
                                      Visibility="{Binding HasVisualization, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

        <!-- Axis group: heading and axis items (standalone axis pairs or complete sticks made from two paired
            axes), each rendered with the matching implicit framed template above. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigAxisGroupViewModel}">
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,0,0" />
        </StackPanel>
    </DataTemplate>

        <!-- Complete physical device content for a tab in the device tab bar (see the Device Configuration tab
            in MainWindow.xaml): a global enabled switch followed by this device's input groups. Replaces the
            per-device expander in the former separate device configuration dialog. -->
    <DataTemplate DataType="{x:Type vm:DeviceConfigDeviceViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0"
                            Content="{loc:Loc devices.benchmark}"
                            Command="{Binding OpenBenchmarkWindowCommand}"
                            ToolTip="{loc:Loc devices.benchmark_tooltip}" />
                    <Button DockPanel.Dock="Right" Padding="8,2"
                            Content="{loc:LocBool Value={Binding IsLogging}, WhenTrue=devices.logging_stop, WhenFalse=devices.logging_start}"
                            Command="{Binding ToggleLoggingCommand}"
                                ToolTip="{Binding LastLogFilePath, TargetNullValue='Continuously logs raw device state (axes/buttons/D-pad) to a text file until clicked again, independently of tab changes.'}" />
                            <CheckBox IsChecked="{Binding Enabled}" Content="{loc:Loc devices.enable}" FontWeight="Bold"
                              VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel IsEnabled="{Binding Enabled}">
                    <ItemsControl ItemsSource="{Binding InputGroups}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
