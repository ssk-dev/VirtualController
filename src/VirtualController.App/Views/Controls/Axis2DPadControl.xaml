<UserControl x:Class="VirtualController.App.Views.Controls.Axis2DPadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualController.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:Axis2DVisualizationViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="120" d:DesignHeight="150">
    <!--
        Generic, read-only live display of a combined X/Y stick as a square coordinate field. The DataContext
        is always an Axis2DVisualizationViewModel. Marker and deadzone positions are calculated relative to
        the actual size only through Grid star rows/columns (FractionToStarGridLengthConverter); there is no
        custom pixel arithmetic or value logic. The Y axis is inverted for display (positive is up), as is
        conventional for a joystick.
    -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
    <StackPanel Width="120" Margin="0,2,0,4">
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:F2}/{1:F2}">
                        <Binding Path="X.Value" />
                        <Binding Path="Y.Value" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <Border Width="120" Height="120" CornerRadius="3" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                 <!-- Deadzone area: a square around the center whose size is proportional to the larger of the
                     configured X/Y deadzones. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding X.DeadzoneStartFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding X.DeadzoneWidthFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding X.AfterDeadzoneFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding YTopDeadzoneFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <RowDefinition Height="{Binding Y.DeadzoneWidthFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <RowDefinition Height="{Binding YBottomDeadzoneFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DeadzoneBox" Grid.Column="1" Grid.Row="1" CornerRadius="2"
                            BorderThickness="1" BorderBrush="{StaticResource PanelBorderBrush}" Background="{StaticResource ButtonHoverBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                     <!-- Fires only on the transition from inside to outside (EnterActions), not
                                         continuously while the state persists, avoiding flicker. -->
                                    <DataTrigger Binding="{Binding IsOutsideDeadzone}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="#FFA726" Duration="0:0:0.12" AutoReverse="True" />
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#FFE0B2" Duration="0:0:0.12" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <!-- Crosshair through the center (neutral point 0,0). -->
                <Rectangle Height="1" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Rectangle Width="1" Fill="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />

                <!-- Current position as a visible dot/marker. Y is inverted for display (positive is up). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding X.MarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="{Binding X.AfterMarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding YTopMarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="{Binding YBottomMarkerFraction, Converter={StaticResource FractionToStarGridLengthConverter}}" />
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Column="1" Grid.Row="1" Width="10" Height="10" Fill="#2D6CDF"
                              Stroke="White" StrokeThickness="1" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
    </Viewbox>
</UserControl>
