<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, Platforms, PlatformTarget, LangVersion: siehe Directory.Build.props -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>VirtualController.Updater</RootNamespace>
    <AssemblyName>VirtualController.Updater</AssemblyName>
    <!-- Programm-Icon fuer die erzeugte EXE (Explorer, Taskleiste, Fenstertitel, Alt+Tab) - dasselbe Icon
         wie die Hauptanwendung, damit der kurzlebige Updater-Prozess trotzdem klar als Teil derselben
         Anwendung erkennbar ist. -->
    <ApplicationIcon>..\..\assets\VirtualController.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publish-Einstellungen: erzeugt bei "dotnet publish" ebenfalls eine eigenstaendige Single-File-EXE
    (kein separates .NET muss auf dem Zielrechner installiert sein) - bewusst identisch zu
    VirtualController.App.csproj (siehe dortige Kommentare). Dieser Updater-Prozess muss unabhaengig von
    einer .NET-Runtime-Installation auf dem Zielrechner funktionieren, da er exakt dann laeuft, wenn die
    Hauptanwendung selbst gerade ausgetauscht wird (siehe VirtualController.Core.Updates.UpdateInstaller).
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- Bewusst KEINE ProjectReference auf VirtualController.Core: dieses kleine, eigenstaendige
       Updater-Projekt (siehe UpdateApplier.cs) soll unabhaengig von Core's nativen
       Treiber-Abhaengigkeiten (ViGEmBus/HidHide/Vortice/HidSharp) bleiben, die fuer den reinen
       Datei-Kopiervorgang nicht benoetigt werden. -->
  <ItemGroup>
    <!-- MIT-lizenzierte, offizielle MVVM-Bausteine (ObservableObject, RelayCommand) - dieselbe bereits im
         App-Projekt verwendete Bibliothek, fuer denselben MVVM-Stil auch in diesem Projekt. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
