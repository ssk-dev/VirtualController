<Application x:Class="VirtualController.Updater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VirtualController.Updater.Converters">
    <Application.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Farbpalette identisch zur Hauptanwendung (siehe VirtualController.App/Themes/Theme.xaml).
             Dieses Updater-Projekt referenziert bewusst keine ProjectReference auf VirtualController.App
             (siehe VirtualController.Updater.csproj) und kann dessen Theme-/Styles-ResourceDictionaries
             daher nicht per MergedDictionaries einbinden - die wenigen benoetigten Brushes werden daher
             hier lokal dupliziert, statt eine Projektabhaengigkeit nur fuer das Farbschema einzufuehren. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#02B4FE" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0B1626" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A517D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7997CB" />
        <SolidColorBrush x:Key="TextBrush" Color="#F6FBFD" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#14385C" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1D5A8F" />

        <!-- Globaler Standard-Look fuer das Updater-Fenster: dunkler App-Hintergrund und helle
             Standard-Schriftfarbe, konsistent mit dem gleichnamigen Style in VirtualController.App/App.xaml. -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="#010d19" />
            <Setter Property="Foreground" Value="#F6FBFD" />
        </Style>

        <!-- Button-Style analog zu VirtualController.App/Themes/Styles.xaml: native WPF-Buttons ignorieren
             einfache Background-/Foreground-Setter aufgrund ihrer Theme-vorgegebenen Chrome, daher ein
             vollstaendiges eigenes ControlTemplate, damit die drei Buttons dieses Fensters ("VirtualController
             starten", "Log-Datei öffnen", "Schließen") denselben dunklen Look wie die Hauptanwendung erhalten. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar-Style analog zu VirtualController.App/Themes/Styles.xaml: native Chrome zeichnet
             eine helle Windows-Standard-Leiste, die auf dem dunklen Hintergrund als Fremdkoerper auffiel.
             Eigenes ControlTemplate mit dunklem Track (PanelBackgroundBrush) und Akzentfarbe als
             Fuellstand - "PART_Track"/"PART_Indicator" muessen exakt so benannt sein, damit WPF die Breite
             des Fuellstands intern automatisch anhand von Value/Minimum/Maximum berechnet. Da dieses
             Projekt keine ProjectReference auf VirtualController.App besitzt, steht hier kein
             AccentGradientBrush zur Verfuegung - der einfache AccentBrush wird stattdessen verwendet. -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="Transparent">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- IsIndeterminate wird fuer den "Bitte warten"-Bildschirm ohne echten
                                 Fortschrittswert verwendet - statt eines statisch-halbleeren Balkens wird
                                 der Indikator hier auf volle Breite gestreckt. -->
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
