<Project>

  <!--
    Zentrale Build-Einstellungen fuer alle Projekte dieser Solution.
    MSBuild importiert diese Datei automatisch fuer jedes Projekt in diesem Verzeichnis
    und allen Unterverzeichnissen - dadurch muessen TargetFramework, Nullable etc. nicht in
    jeder einzelnen .csproj wiederholt werden.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Verhindert, dass der .NET SDK die per Directory.Build.targets ("ComputeVersionFromGitTag") aus dem
      Git-Tag ermittelte Version (z.B. "1.4.2") automatisch um ein "+<Commit-SHA>"-Suffix im
      AssemblyInformationalVersionAttribute ergaenzt. Ohne diese Einstellung wuerde die in der Titelzeile
      angezeigte Version (siehe AppVersionProvider) je nach Commit variieren, obwohl sie fuer denselben
      Git-Tag stets identisch sein soll.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
