<Project>

  <!--
    Automatically derives the app version from the Git tag used to build the current checkout
    (e.g. tag "v1.4.2" -> version "1.4.2"), avoiding manual updates in each .csproj or multiple source files.
    MSBuild imports Directory.Build.targets after each .csproj (unlike Directory.Build.props, which is
    imported before it). This ensures the target runs before GetAssemblyVersion/GenerateAssemblyInfo and
    can set $(Version) in time.

    At runtime, the derived version is available through
    VirtualController.Core.Updates.AppVersionProvider.CurrentVersion, which reads the
    AssemblyInformationalVersionAttribute from the compiled assembly.
  -->
  <Target Name="ComputeVersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile" Condition="'$(VirtualControllerVersion)' == ''">

    <!--
      The "exact-match" option (see the Exec command below) returns a tag only when the current commit (HEAD)
      is tagged directly, not merely descended from a tag. This yields the version used for this exact build
      rather than an approximate/derived version. The release workflow (.github/workflows/release.yml) checks
      out the pushed tag, so this reliably returns the correct version there. For local development builds
      (no tag on the current commit, Git not installed, or no Git repository, such as a source ZIP checkout),
      the command intentionally fails. ContinueOnError prevents that from failing the build, and the fallback
      below is used instead.
    -->
    <Exec Command="git describe --tags --exact-match --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue"
          WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>

    <PropertyGroup>
      <_GitTag>@(_GitDescribeOutput)</_GitTag>
      <_GitTagVersion>$(_GitTag.TrimStart('v'))</_GitTagVersion>
      <!-- Additional validation beyond git describe's glob match: ensure this is a valid SemVer
           "Major.Minor.Patch" version with an optional "-PreRelease" suffix (e.g. "1.2.0" or "1.2.0-alpha";
           this project frequently uses suffixes such as "-alpha") before deriving version and assembly
           metadata. Uses the same format as SemanticVersion.cs. -->
      <_GitTagVersionIsValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitTagVersion)', '^\d+\.\d+\.\d+(?:-[0-9A-Za-z.\-]+)?$'))">true</_GitTagVersionIsValid>
      <!-- The numeric Major.Minor.Patch portion without a prerelease suffix. AssemblyVersion/FileVersion
           require a numeric four-component format and cannot include an "-alpha" suffix (see below). -->
      <_GitTagVersionCore Condition="'$(_GitTagVersionIsValid)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match('$(_GitTagVersion)', '^\d+\.\d+\.\d+').Value)</_GitTagVersionCore>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_GitDescribeExitCode)' == '0' AND '$(_GitTagVersionIsValid)' == 'true'">
      <VirtualControllerVersion>$(_GitTagVersion)</VirtualControllerVersion>
    </PropertyGroup>

    <!-- Fallback for development builds without a matching Git tag on the current commit. -->
    <PropertyGroup Condition="'$(VirtualControllerVersion)' == ''">
      <VirtualControllerVersion>0.0.0-dev</VirtualControllerVersion>
    </PropertyGroup>

    <PropertyGroup>
      <Version>$(VirtualControllerVersion)</Version>
      <InformationalVersion>$(VirtualControllerVersion)</InformationalVersion>
      <!-- AssemblyVersion/FileVersion require a numeric four-component format and cannot include a "-dev"
           suffix. Set them only when the version comes from a valid Git tag. In the development fallback,
           the assembly retains the MSBuild default version "1.0.0.0", while AppVersionProvider still reads
           and displays the correct InformationalVersion, "0.0.0-dev". -->
      <AssemblyVersion Condition="'$(_GitTagVersionIsValid)' == 'true'">$(_GitTagVersionCore).0</AssemblyVersion>
      <FileVersion Condition="'$(_GitTagVersionIsValid)' == 'true'">$(_GitTagVersionCore).0</FileVersion>
    </PropertyGroup>

    <Message Importance="high" Text="VirtualController version derived from Git tag: $(VirtualControllerVersion)" />
  </Target>

</Project>
